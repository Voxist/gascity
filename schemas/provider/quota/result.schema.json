{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "accounts",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "ok": {
      "const": true
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "ok"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "quota": {
            "type": "object",
            "required": [
              "provider",
              "five_hour_util",
              "seven_day_util"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "five_hour_util": {
                "type": "number"
              },
              "five_hour_resets_at": {
                "type": "string"
              },
              "seven_day_util": {
                "type": "number"
              },
              "seven_day_resets_at": {
                "type": "string"
              },
              "opus_util": {
                "type": "number"
              },
              "sonnet_util": {
                "type": "number"
              }
            },
            "additionalProperties": true
          },
          "reason_class": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "prefer_sonnet": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
