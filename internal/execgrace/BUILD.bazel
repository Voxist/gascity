load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "execgrace",
    srcs = [
        "execgrace.go",
        "signal_unix.go",
        "signal_windows.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/execgrace",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "execgrace_test",
    srcs = [
        "apply_unix_test.go",
        "execgrace_test.go",
        "testenv_import_test.go",
    ],
    embed = [":execgrace"],
    deps = [
        "//internal/testenv",
    ] + select({
        "@rules_go//go/platform:aix": [
            "//internal/testutil",
        ],
        "@rules_go//go/platform:android": [
