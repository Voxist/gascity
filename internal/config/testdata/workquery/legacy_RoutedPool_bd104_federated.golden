sh -c 'pool_gate_skipped=0; case "$GC_SESSION_ORIGIN" in ephemeral|"") ;; *) pool_gate_skipped=1 ;; esac; probe_pool_demand() { target="$1"; [ -z "$target" ] && return 1; r=$(gc ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort hybrid --limit=20) || exit $?; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_candidates=$(gc ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit=20) || exit $?; r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select((.metadata["gc.routed_to"] // "") == "")] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_ephemeral_candidates=$({ bd query --json '\''ephemeral=true AND status=open'\'' --limit=0 2>/dev/null | jq --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0) | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "") | .[:20]'\'' 2>/dev/null; } || printf "[]"); r=$(printf "%s" "$legacy_ephemeral_candidates" | jq '\''.[0:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; return 1; }; [ "$pool_gate_skipped" = "0" ] && probe_pool_demand "$1"; [ "$pool_gate_skipped" = "0" ] && probe_pool_demand "$2"; [ "$pool_gate_skipped" = "1" ] && printf "gc: work_query pool tier not probed: origin=%s is not ephemeral; routed pool work (if any) was NOT considered\n" "$GC_SESSION_ORIGIN" >&2; printf "[]"' -- rig/control-dispatcher rig/workflow-control