sh -c 'pool_gate_self_only=0; pool_gate_skipped=0; case "$GC_SESSION_ORIGIN" in ephemeral|"") ;; *) pool_gate_self_only=1 ;; esac; pool_target_allowed() { [ "$pool_gate_self_only" = "0" ] && return 0; [ -n "$1" ] || return 1; t=$(printf "%s" "$1" | tr "/." ".."); a=$(printf "%s" "$GC_ALIAS" | tr "/." ".."); [ "$t" = "$a" ] && return 0; g=$(printf "%s" "$GC_AGENT" | tr "/." ".."); [ "$t" = "$g" ] && return 0; case "$a" in "$t"-[0-9]*) return 0 ;; esac; case "$g" in "$t"-[0-9]*) return 0 ;; esac; pool_gate_skipped=1; return 1; }; probe_pool_demand() { target="$1"; [ -z "$target" ] && return 1; r=$(gc ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit=20) || exit $?; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_candidates=$(gc ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit=20) || exit $?; r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select((.metadata["gc.routed_to"] // "") == "")] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_ephemeral_candidates=$({ bd query --json '\''ephemeral=true AND status=open'\'' --limit=0 2>/dev/null | jq --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0) | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "") | .[:20]'\'' 2>/dev/null; } || printf "[]"); r=$(printf "%s" "$legacy_ephemeral_candidates" | jq '\''.[0:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; return 1; }; pool_target_allowed "$1" && probe_pool_demand "$1"; pool_target_allowed "$2" && probe_pool_demand "$2"; [ "$pool_gate_skipped" = "1" ] && printf "gc: work_query pool tier gated: origin=%s has no self-addressed target; routed work may exist\n" "$GC_SESSION_ORIGIN" >&2; printf "[]"' -- rig/control-dispatcher rig/workflow-control