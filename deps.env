# Pinned dependency versions for CI and Docker builds.
# See docs/image-dependency-versioning.md for the versioning strategy.
#
# Update these when bumping automation/image pins. The internal/deps package
# defines minimum compatible versions (may lag behind these pins).

DOLT_VERSION=2.1.7
BD_REPO=Voxist/beads
# BD_VERSION is the bd binary CI and images run alongside gc — the VERSION
# STRING, matching what cmd/bd/version.go declares in the pinned source. It is
# asserted and stamped by contrib/k8s/Dockerfile.agent.
#
# FORK-FIRST BRIDGE (supersedes the ADR-0026 C5 upstream bridge; ga-zzcjs):
# the fleet's bd builds from the Voxist/beads fork tip, which carries schema
# 0062 plus fork-only fixes; no published upstream release carries 0062 yet.
# Three pins, three different things:
#
#   BD_SOURCE_REF  — the Voxist/beads commit the bd BINARY builds from
#                    (images via Dockerfile.agent, CI via
#                    install-bd-archive.sh with BD_REPO).
#   BD_LIB_REF     — the upstream commit gc's go.mod LINKS as a library.
#                    Fork commits do not resolve on the module path
#                    (github.com/steveyegge/beads redirects to the upstream
#                    repo), so the lib pin is the newest UPSTREAM ANCESTOR of
#                    BD_SOURCE_REF: same schema (0062), no fork-only deltas.
#                    go.mod's pseudo-version commit must equal this ref
#                    (enforced by TestBuildPinnedBDBinaryForTestsUsesGoModSource
#                    and scripts/bd_version_pin_test.go).
#   BD_SOURCE_SHA256 — sha256 of the BD_SOURCE_REF source tarball from BD_REPO.
#
# When a release >= 0062 exists on a repo the module path resolves: set
# BD_VERSION to that tag, delete BD_SOURCE_REF/BD_LIB_REF/BD_SOURCE_SHA256,
# and repin go.mod — in ONE change.
BD_VERSION=v1.1.0
BD_SOURCE_REF=a75c226c97d8ab7c0ae0359fb258e6cfd80bf72b
BD_LIB_REF=4ebc98927cca05198c68fd04a42c979cf48207e9
BD_SOURCE_SHA256=10f9356ebd047266997d417082b51eb7dc913eff63b4facef918c63ce0e1b4b7
BR_VERSION=0.1.20

# Cross-version contract-test matrix pins.
# See engdocs/design/beads-gascity-contract-test-system.md.
# BD_PREV_VERSION is the minimum-supported bd: a published release whose tarball
# SHA is pinned in .github/scripts/install-bd-archive.sh (no API fallback on the
# required path). BD_CURRENT_VERSION is the bleeding-edge release-candidate; it
# has no release tarball, so the matrix builds it from beads source at
# BD_CURRENT_REF (a gastownhall/beads commit). Bump BD_CURRENT_REF deliberately,
# in lockstep with the vendored corpus, per the coordination protocol.
BD_PREV_VERSION=v1.0.4
BD_CURRENT_VERSION=v1.1.1-0.20260805093327-bf97b73749ac
BD_CURRENT_REF=bf97b73749ac3ef2fca2365b54537ac041ad4293
