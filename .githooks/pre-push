#!/usr/bin/env bash
set -euo pipefail

# Heavy `go test` fan-out runs here, at push time, instead of on every commit
# (#3628). pre-commit previously invoked `make test-fast-parallel` on every
# commit. Its outer shard fan-out can compile ~2.8 GiB test binaries per job,
# so the canonical runner now derives concurrency from both CPU and available
# memory while preserving an explicit LOCAL_TEST_JOBS override. Running the
# suite at push time also fires it only when Go sources actually change.
#
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref
# on stdin (see githooks(5)).

zero="0000000000000000000000000000000000000000"

repo_root="$(git rev-parse --show-toplevel)"

# The ref list arrives once on stdin but two consumers need it: the beads chain
# and the Go-change scan below. Buffer it and replay it to each.
refs_stdin="$(cat)"

# `$(cat)` strips trailing newlines, so re-terminate the final line: `read`
# returns non-zero on an unterminated line and the scan would drop it. The
# emptiness guard keeps `printf` from manufacturing a blank ref line.
replay_refs() {
  [ -n "$refs_stdin" ] && printf '%s\n' "$refs_stdin"
  return 0
}

# .githooks owns core.hooksPath, so this call is the only thing keeping beads'
# own pre-push hook alive.
"$repo_root/.githooks/lib/beads-chain.sh" pre-push "$@" < <(replay_refs)

go_changed=0
any_non_deletion=0
resync_loss_merges=()
pushed_shas=()
pushed_refs=()
while read -r local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion — nothing to test, nothing to guard.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  any_non_deletion=1
  pushed_shas+=("$local_sha")
  pushed_refs+=("$local_ref")
  # New remote branch: no cheap base to diff against — run the suite.
  if [ "$remote_sha" = "$zero" ]; then
    go_changed=1
    # No bounded range to scan either. The cheapest check available for a
    # brand-new branch is whether its pushed tip itself is a merge commit
    # (`^2` only resolves when local_sha has a second parent) — walking the
    # branch's entire history here would re-check commits that already
    # passed this gate when they first entered fork/main.
    if git rev-parse -q --verify "${local_sha}^2" >/dev/null 2>&1; then
      resync_loss_merges+=("$local_sha")
    fi
  else
    # Captured, never piped into `grep -q` (ga-gvag6): under pipefail, grep
    # exits on the first name, git diff takes SIGPIPE writing the rest, and
    # the pipeline reads as false — so a large Go diff skipped the suite
    # silently. A diff that cannot be computed (remote tip not present
    # locally) fails closed and runs the suite.
    if ! go_diff="$(git diff --name-only "$remote_sha" "$local_sha" -- '*.go' 2>/dev/null)" ||
      [ -n "$go_diff" ]; then
      go_changed=1
    fi
    # Category-A resync-loss gate (ga-d32bn; AGENTS.md "Resync conventions"
    # rule 5): every merge commit this push introduces, not just the pushed
    # tip. AGENTS.md's own preamble records that a resync's merge commit is
    # routinely followed by a `fix(resync)`/`chore(regen)` cleanup commit on
    # top before push — checking only `local_sha^2` would miss the merge
    # entirely the moment that happens. `git rev-list --merges` over the
    # pushed range is one cheap git-native scan (no script invocation) per
    # ref; an ordinary non-merge push finds nothing and never invokes
    # check-resync-loss.sh at all.
    while IFS= read -r merge_sha; do
      [ -n "$merge_sha" ] || continue
      resync_loss_merges+=("$merge_sha")
    done < <(git rev-list "${remote_sha}..${local_sha}" --merges 2>/dev/null)
  fi
done < <(replay_refs)

# check-resync-loss.sh runs once per distinct merge commit found above
# (deduped: the same merge can reach this hook via more than one pushed
# ref). Before this, the gate only ran when an operator remembered the
# AGENTS.md sentence; wiring it here makes it unconditional.
#
# Escape hatch is a dedicated RESYNC_LOSS_ACK=1, not `git push --no-verify`:
# --no-verify also disarms the unrelated ga-fip9ps.1 bead-ownership guard
# below and the test-fast-parallel run at the bottom of this hook, which is
# far more than an operator acknowledging a triaged resync-loss report
# should have to give up.
if [ "${#resync_loss_merges[@]}" -gt 0 ] && [ "${RESYNC_LOSS_ACK:-0}" != "1" ]; then
  deduped=()
  while IFS= read -r merge_sha; do
    [ -n "$merge_sha" ] || continue
    deduped+=("$merge_sha")
  done < <(printf '%s\n' "${resync_loss_merges[@]}" | sort -u)
  repo_root="$(git rev-parse --show-toplevel)"
  for merge_sha in "${deduped[@]}"; do
    if ! (cd "$repo_root" && make check-resync-loss MERGE="$merge_sha"); then
      echo "pre-push: check-resync-loss failed for merge commit $merge_sha (bead ga-d32bn) — see output above. Bypass (only after triage): RESYNC_LOSS_ACK=1 git push" >&2
      exit 1
    fi
  done
fi

# Bead ownership/staleness guard (ga-fip9ps.1): re-checks bd claim state
# immediately before this push leaves the machine, once per invocation
# (not per ref) regardless of whether Go sources changed. A mayor ruling
# (reassign/close/hold/reroute) that landed after this push was queued
# must not be allowed to clobber a branch another agent has since taken
# over. Bypass: `git push --no-verify`.
if [ "$any_non_deletion" -eq 1 ]; then
  # shellcheck source=../scripts/push-ownership-guard.sh disable=SC1091
  . "$repo_root/scripts/push-ownership-guard.sh"
  if ! assert_bead_still_claimed; then
    exit 1
  fi
fi

if [ "$go_changed" -eq 0 ]; then
  exit 0
fi

# Gate 3 (fast test tier) escape hatch: LOCAL_TESTS_ACK=<sha>, for the same
# reason RESYNC_LOSS_ACK exists above (vc-dq0b). `git push --no-verify` is the
# only other bypass this gate has, and it disarms all three gates at once —
# including the ga-fip9ps.1 bead-ownership guard, which is fail-closed precisely
# because a stale push already clobbered another agent's base (PR #4243). A
# host-dependent tier failure should not cost that guard.
#
# Scoped by position: gates 1 and 2 have already run and passed by the time
# control reaches here, so this ack can only skip the tier below it.
#
# Bound to the push: the value must be the commit being pushed — its full SHA
# or a prefix of at least 7 hex characters — and every ref in this push must
# carry that one commit. `1`, a stale SHA left exported from an earlier push, or
# a push of several different commits does NOT skip the tier; the hook says why
# and runs it. An ack therefore covers exactly the commit its operator looked
# at, never a later one.
#
# The notice is deliberately named and greppable, and names the acked commit
# and refs: --no-verify leaves no trace at all, so an audit cannot distinguish a
# skipped tier from a passing one.
if [ -n "${LOCAL_TESTS_ACK:-}" ]; then
  ack="$(printf '%s' "$LOCAL_TESTS_ACK" | tr 'A-F' 'a-f')"
  ack_reason=""
  distinct_shas="$(printf '%s\n' "${pushed_shas[@]}" | sort -u)"
  if ! [[ "$ack" =~ ^[0-9a-f]{7,40}$ ]]; then
    ack_reason="it is not a commit SHA (need the pushed commit's full SHA or a prefix of at least 7 hex characters)"
  elif [ "$(printf '%s\n' "$distinct_shas" | grep -c .)" -ne 1 ]; then
    ack_reason="this push carries more than one commit; push them separately"
  elif [ "${distinct_shas#"$ack"}" = "$distinct_shas" ]; then
    ack_reason="it does not match the pushed commit $distinct_shas (stale ack?)"
  fi
  if [ -z "$ack_reason" ]; then
    echo "pre-push: LOCAL_TESTS_ACK=$LOCAL_TESTS_ACK — gate 3 (make test-fast-parallel) SKIPPED by operator acknowledgement for commit $distinct_shas (refs: ${pushed_refs[*]}); gates 1 (resync-loss) and 2 (bead-ownership) were not bypassed by this ack (vc-dq0b)" >&2
    exit 0
  fi
  echo "pre-push: LOCAL_TESTS_ACK=$LOCAL_TESTS_ACK IGNORED — $ack_reason. Running gate 3. To skip it for this push: LOCAL_TESTS_ACK=\$(git rev-parse <pushed-ref>) git push ..." >&2
fi

# The Makefile and direct sharded runner share scripts/test-local-job-count as
# their default policy. Do not shadow it here; an explicit override still wins.
exec make test-fast-parallel
