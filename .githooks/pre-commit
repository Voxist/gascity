#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# Beads runs first so a bead-validation rejection short-circuits before the
# expensive codegen below. .githooks owns core.hooksPath, so this call is the
# only thing keeping beads' own pre-commit alive.
"$repo_root/.githooks/lib/beads-chain.sh" pre-commit ${1+"$@"}

# `go clean -cache` guard (fork-maintainer-guide.md "Build Cache Conventions"; bead vp-g96b).
# Runs BEFORE the four-category early exit below, because the files most likely
# to acquire the command -- a shell script, a Makefile recipe, a CI step, an
# order -- are in none of those four categories and would otherwise be skipped
# entirely. Cheap: it scans only the staged content, so a commit that stages
# nothing does no work.
#
# This is regression prevention, not incident prevention. Nothing was committed
# in either the 2026-06-13 (vp-g96b) or 2026-09-05 wipe; a process ran the
# command. Enforcing that at run time needs the PATH shim
# (scripts/go-clean-cache-shim.sh), which no hook can substitute for.
#
# Resolved relative to THIS FILE, not to the working directory: git runs a hook
# with cwd at the top of whatever repo is being committed to, which is not
# necessarily the repo the hook itself ships in (the contract tests in
# scripts/precommit_contract_test.go drive this hook against a temp repo, and a
# `git worktree` commit does the same thing in production).
# Parameter expansion only -- `dirname` is not a shell builtin, and this hook
# runs under a deliberately restricted PATH in the contract tests.
gcc_hook_dir="${BASH_SOURCE[0]%/*}"
[ "$gcc_hook_dir" = "${BASH_SOURCE[0]}" ] && gcc_hook_dir="."
gcc_guard="$gcc_hook_dir/../scripts/check-go-clean-cache.sh"
if [ ! -x "$gcc_guard" ]; then
  echo "pre-commit: $gcc_guard is missing or not executable — refusing to commit with the build-cache ban guard disabled (fork-maintainer-guide.md \"Build Cache Conventions\")" >&2
  exit 1
fi
if ! "$gcc_guard" --staged; then
  exit 1
fi
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)
staged_web_src=$(git diff --cached --name-only --diff-filter=ACM -- 'internal/api/dashboardspa/web/shared/src/' 'internal/api/dashboardspa/web/frontend/src/' 'internal/api/dashboardspa/web/frontend/index.html' 'internal/api/dashboardspa/web/frontend/public/' 'internal/api/dashboardspa/web/package.json' 'internal/api/dashboardspa/web/shared/package.json' 'internal/api/dashboardspa/web/frontend/package.json' 'internal/api/dashboardspa/web/frontend/vite.config.ts' 'internal/api/dashboardspa/web/frontend/tsconfig.json' 'internal/api/dashboardspa/web/shared/tsconfig.json' || true)
staged_docs=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' 'docs/**' 'engdocs/**' 'plans/**' 'specs/**' 'AGENTS.md' 'CONTRIBUTING.md' 'README.md' 'TESTING.md' || true)
staged_spec=$(git diff --cached --name-only --diff-filter=ACM -- 'internal/api/openapi.json' || true)

if [ -z "$staged_go_files" ] && [ -z "$staged_web_src" ] && [ -z "$staged_docs" ] && [ -z "$staged_spec" ]; then
  exit 0
fi

if [ -n "$staged_go_files" ]; then
  printf '%s\n' "$staged_go_files" | scripts/precommit-format-staged-go
  printf '%s\n' "$staged_go_files" | xargs git add

  # Lint and vet: nogo (//tools/nogo) over the staged files' Bazel packages,
  # the same analyzers bazel.yml gates on. Findings fail the commit; nogo
  # prints a `patch -p1` command for the ones with suggested fixes.
  #
  # ga-w7nyj: nothing here may auto-fix staged code. golangci-lint's stock
  # errorlint --fix silently drops the negation on `if _, ok := x.(*T); !ok`
  # (Voxist/gascity#219 and #231 both hit it); see
  # TestPreCommitLintChangedFlagsDoNotAutoFix in scripts/precommit_contract_test.go.
  #
  # Fork: GC_PRECOMMIT_LINT=go swaps nogo for `go vet` over the staged
  # packages, mirroring GC_PREPUSH_SUITE=go. It exists for hosts Bazel does
  # not serve: on macOS the stock LLVM toolchain cannot compile the cgo deps
  # (dolthub ICU/zstd), and every worktree path gets its own Bazel output
  # base, which a shared host with many worktrees cannot afford per commit.
  case "${GC_PRECOMMIT_LINT:-bazel}" in
    go)
      echo "pre-commit: GC_PRECOMMIT_LINT=go: running go vet over the staged packages, NOT nogo; CI's bazel.yml gates on nogo. Unset GC_PRECOMMIT_LINT to run nogo." >&2
      # Builtins only: the hook runs under a restricted PATH (see above).
      # Each package is vetted inside the module that owns it: the repo
      # carries nested modules (tools/nogo) that the root module cannot load.
      vet_entries=()
      while IFS= read -r file; do
        case "$file" in
          ""|testdata/*|*/testdata/*) continue ;;
        esac
        dir="${file%/*}"
        [ "$dir" = "$file" ] && dir="."
        mod="$dir"
        while [ "$mod" != "." ] && [ ! -f "$mod/go.mod" ]; do
          case "$mod" in
            */*) mod="${mod%/*}" ;;
            *) mod="." ;;
          esac
        done
        if [ "$mod" = "." ]; then rel="./$dir"; else rel="./${dir#"$mod"}"; rel="${rel/#.\/\//./}"; fi
        [ "$rel" = "./" ] && rel="."
        entry="$mod|$rel"
        case " ${vet_entries[*]-} " in
          *" $entry "*) ;;
          *) vet_entries+=("$entry") ;;
        esac
      done <<<"$staged_go_files"
      vet_mods=()
      for entry in ${vet_entries[@]+"${vet_entries[@]}"}; do
        case " ${vet_mods[*]-} " in
          *" ${entry%%|*} "*) ;;
          *) vet_mods+=("${entry%%|*}") ;;
        esac
      done
      for mod in ${vet_mods[@]+"${vet_mods[@]}"}; do
        mod_pkgs=()
        for entry in "${vet_entries[@]}"; do
          [ "${entry%%|*}" = "$mod" ] && mod_pkgs+=("${entry#*|}")
        done
        # Skip packages whose files build constraints exclude (go vet
        # refuses them outright); vet the buildable ones by import path.
        buildable=$(go -C "$mod" list -e -f '{{if or .GoFiles .CgoFiles .TestGoFiles .XTestGoFiles}}{{.ImportPath}}{{end}}' "${mod_pkgs[@]}") || exit 1
        if [ -n "$buildable" ]; then
          # shellcheck disable=SC2086 # one import path per word
          go -C "$mod" vet $buildable || exit 1
        fi
      done
      ;;
    bazel)
      make lint-changed LINT_CHANGED_SCOPE=staged || exit 1
      ;;
    *)
      echo "pre-commit: unknown GC_PRECOMMIT_LINT=${GC_PRECOMMIT_LINT}; expected bazel (default) or go" >&2
      exit 2
      ;;
  esac

  # Regenerate the OpenAPI spec from the live Huma API and stage both
  # canonical copies. Keeps the committed spec and the published
  # Mintlify schema in lockstep with whatever the server actually
  # serves.
  go run ./cmd/genspec
  git add internal/api/openapi.json docs/reference/schema/openapi.json docs/reference/schema/openapi.txt

  go generate ./internal/api/genclient
  git add internal/api/genclient/client_gen.go

  # Regenerate the config/schema docs derived from Go structs and
  # stage every generated artifact so commits do not leave the
  # worktree dirty.
  go run ./cmd/genschema
  git add docs/reference/schema/city-schema.json docs/reference/schema/city-schema.txt docs/reference/config.md docs/reference/cli.md

  # Heavy `go test` fan-out runs in .githooks/pre-push, not here (#3628).
  # Invoking `make test-fast-parallel` on every commit fired an
  # `xargs -P<nproc>` storm of ~2.8 GB test-binary compiles (~17 GB pressure,
  # load >100 on constrained hosts such as WSL). Format, lint/vet (nogo), and
  # codegen stay in pre-commit; the test suite gates at push time instead.
fi

# make check-docs gates on the same Bazel docsync target CI runs. Where this
# host cannot run Bazel (no bazel, or a loader that cannot resolve the pinned
# ICU runtime, lib/local-runtime.sh), auto runs the go twin behind a banner
# instead: it is not the Bazel gate, but a genuine docs failure still blocks
# the commit. GC_PRECOMMIT_DOCS=auto|bazel|go picks the engine; the explicit
# values are never replaced.
announce_go_docs() {
  {
    echo "pre-commit: running make check-docs-go (go test ./test/docsync): NOT the Bazel docs gate CI enforces."
    echo "pre-commit: why: $docs_why"
    echo "pre-commit: CI runs bazel test //... (.github/workflows/bazel.yml), whose docsync target runs hermetically on its declared inputs."
    echo "pre-commit: This ran the whole docsync suite on this host's files and ICU instead, so a commit that passes here can still fail there"
    echo "pre-commit: (TestNestedAgentsFilesHaveClaudeSymlink, for one, is stricter under go)."
    echo "pre-commit: fix: $docs_fix"
  } >&2
}

if [ -n "$staged_docs" ]; then
  docs_mode="${GC_PRECOMMIT_DOCS:-auto}"
  docs_why="GC_PRECOMMIT_DOCS=go"
  docs_fix="unset GC_PRECOMMIT_DOCS, or set GC_PRECOMMIT_DOCS=bazel, to run the Bazel docs gate"
  # Fork: GC_PRECOMMIT_LINT=go also takes the docs check off Bazel unless
  # GC_PRECOMMIT_DOCS names an engine explicitly.
  if [ -z "${GC_PRECOMMIT_DOCS:-}" ] && [ "${GC_PRECOMMIT_LINT:-bazel}" = "go" ]; then
    docs_mode=go
    docs_why="GC_PRECOMMIT_LINT=go"
    docs_fix="unset GC_PRECOMMIT_LINT, or set GC_PRECOMMIT_DOCS=bazel, to run the Bazel docs gate"
  fi
  case "$docs_mode" in
  auto)
    if ! command -v bazel >/dev/null 2>&1; then
      docs_why="bazel is not installed"
      docs_fix="install bazelisk (engdocs/bazel-quickstart.md); GC_PRECOMMIT_DOCS=bazel then runs make check-docs"
      docs_mode=go
    else
      # shellcheck source=lib/local-runtime.sh
      . "$repo_root/.githooks/lib/local-runtime.sh"
      local_runtime_assess
      if [ "$local_runtime_state" = ok ]; then
        docs_mode=bazel
      else
        docs_why="$(local_runtime_why)"
        docs_fix="use a remote executor (BAZEL_FLAGS=--config=remote-exec make check-docs), or $(local_runtime_resolve_hint); GC_PRECOMMIT_DOCS=bazel forces make check-docs regardless"
        docs_mode=go
      fi
    fi
    ;;
  bazel | go) ;;
  *)
    echo "pre-commit: GC_PRECOMMIT_DOCS=$docs_mode is not one of auto, bazel, go" >&2
    exit 2
    ;;
  esac
  if [ "$docs_mode" = go ]; then
    announce_go_docs
    make check-docs-go
  else
    make check-docs
  fi
fi

# Re-read the index rather than reusing the pre-hook staged_spec snapshot:
# the Go block above runs `go run ./cmd/genspec` and stages the regenerated
# internal/api/openapi.json, so a Go-only commit that moves the API surface
# only shows up here (#4627, #4607). Shared by both branches below so the
# npm-absent fail-closed branch sees the same side effect the npm-present
# branch already accounts for (ga-jg89a5) -- the branches must not diverge
# on which snapshot of "is the spec staged" they trust.
spec_changed=$(git diff --cached --name-only --diff-filter=ACM -- 'internal/api/openapi.json' || true)

# Dashboard SPA rebuild: when internal/api/openapi.json changes, regenerate
# the generated TS API client from the new spec and stage it. When the spec
# OR the SPA source changes, typecheck and rebuild the compiled bundle.
# Guarded on `npm` availability so contributors without Node tooling aren't
# blocked; CI enforces the full regeneration via make dashboard-ci.
if command -v npm >/dev/null 2>&1; then
  if [ -n "$spec_changed" ]; then
    # Regenerate BEFORE typecheck/build below: a client that no longer
    # matches the new spec must fail typecheck immediately instead of
    # silently building/committing a stale client (#4627, #4607).
    (cd internal/api/dashboardspa/web && npm ci --silent && npm run generate:client)
    git add internal/api/dashboardspa/web/shared/src/generated/gc-supervisor-client
  fi
  if [ -n "$spec_changed" ] || [ -n "$staged_web_src" ]; then
    # Typecheck BEFORE build: vite's build transpiles TS to JS and
    # silently ignores type errors. The Makefile target also runs the
    # Vitest suite, builds dist/, and smoke-runs the compiled SPA via
    # Vite preview so a bundle that builds but won't serve is caught
    # before CI.
    # Heavy (npm typecheck + Vitest + build + preview smoke). Like the Go test
    # suite above, gate it behind GC_PRECOMMIT_FULL so routine/agent commits
    # aren't wedged; CI enforces the full dashboard regeneration.
    if [ -n "${GC_PRECOMMIT_FULL:-}" ]; then
      make dashboard-check dashboard-smoke
      git add internal/api/dashboardspa/dist
    else
      echo "pre-commit: skipping dashboard typecheck/build (set GC_PRECOMMIT_FULL=1 to run; CI enforces it)" >&2
    fi
  fi
else
  if [ -n "$spec_changed" ]; then
    echo "error: internal/api/openapi.json is staged but npm is not on PATH — the generated TS API client" >&2
    echo "cannot be regenerated, so this commit would ship a stale client with no enforcement until CI runs." >&2
    echo "Install Node/npm, or regenerate manually:" >&2
    echo "  cd internal/api/dashboardspa/web && npm ci && npm run generate:client" >&2
    exit 1
  fi
  echo "warning: npm not on PATH — skipped dashboard SPA typecheck + rebuild. CI will enforce this." >&2
fi
