From f51498c94ddbdc594b0c06256522c36db6f4fc6c Mon Sep 17 00:00:00 2001
From: bourgois <karel@voxist.com>
Date: Sun, 7 Jun 2026 17:57:57 +0200
Subject: [PATCH] fix(sec): treat macOS /Users/Shared as a safe BEADS_DIR
 boundary (SEC-003)

The SEC-003 path-boundary check rejected any /Users/ path not under the
current user's home as 'another user's home directory'. macOS's
system-designated shared workspace /Users/Shared is group-writable and not
a user home, so a beads store placed there (a shared multi-agent city)
made 'bd context' hard-fail with 'BEADS_DIR points to unsafe location'.
Allow /Users/Shared explicitly, mirroring the existing /var/home exception.
---
 internal/beads/context.go      | 7 +++++++
 internal/beads/context_test.go | 5 +++++
 2 files changed, 12 insertions(+)

diff --git a/internal/beads/context.go b/internal/beads/context.go
index b434951bb..31c0ce59c 100644
--- a/internal/beads/context.go
+++ b/internal/beads/context.go
@@ -326,6 +326,13 @@ func isPathInSafeBoundary(path string) bool {
 		return true
 	}
 
+	// Allow macOS's system-designated shared directory (/Users/Shared). It is a
+	// legitimate shared workspace blessed by the OS, not another user's home, so
+	// it must not be rejected by the "other users' home directory" check below.
+	if absPath == "/Users/Shared" || strings.HasPrefix(absPath, "/Users/Shared/") {
+		return true
+	}
+
 	for _, prefix := range unsafePrefixes {
 		if strings.HasPrefix(absPath, prefix+"/") || absPath == prefix {
 			return false
diff --git a/internal/beads/context_test.go b/internal/beads/context_test.go
index bd418d965..5afb60d08 100644
--- a/internal/beads/context_test.go
+++ b/internal/beads/context_test.go
@@ -375,6 +375,11 @@ func TestIsPathInSafeBoundary(t *testing.T) {
 		// Safe paths - should be accepted
 		{"user home directory", filepath.Join(homeDir, "projects/.beads"), true},
 		{"temp directory", os.TempDir(), true},
+
+		// macOS system-designated shared directory - a legitimate shared
+		// workspace, must not be rejected as "another user's home" (SEC-003 regression).
+		{"macOS /Users/Shared", "/Users/Shared", true},
+		{"macOS /Users/Shared subdir", "/Users/Shared/Github/voxist-city/.beads", true},
 	}
 
 	for _, tt := range tests {
-- 
