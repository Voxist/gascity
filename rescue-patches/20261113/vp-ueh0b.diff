diff --git a/cmd/gc/city_discovery.go b/cmd/gc/city_discovery.go
index c5b7061e1..66d672e70 100644
--- a/cmd/gc/city_discovery.go
+++ b/cmd/gc/city_discovery.go
@@ -133,5 +133,14 @@ func normalizeDiscoveryPath(path string) string {
 	if err == nil {
 		path = abs
 	}
+	// Resolve symlinks so ceiling comparisons work regardless of whether the
+	// path was obtained via os.Getwd() (which may or may not resolve symlinks
+	// depending on how the chdir was performed) or a literal string.
+	// A configured-but-nonexistent ceiling entry silently stops bounding
+	// discovery (EvalSymlinks fails → unresolved path is used → dir never
+	// equals ceiling) — deliberate tradeoff, documented here.
+	if resolved, err := filepath.EvalSymlinks(path); err == nil {
+		path = resolved
+	}
 	return filepath.Clean(path)
 }
