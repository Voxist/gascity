+// supervisorLaunchdHomeRootedPathGuard refuses a launchd install whose
+// GC_HOME or log paths do not resolve under the user's home directory
+// (bead vp-ry9jm, leg D). The 2026-09-08 census found 13 supervisor plists
+// provisioned by an integration-test harness with TMPDIR-rooted GC_HOME and
+// log paths: 8 loaded and crash-looping (exit 78), every one writing crash
+// output to a path that died with the harness. The guard must lead content —
+// without it the contamination silently returns the next time a harness
+// runs `gc supervisor install` against the real LaunchAgents directory.
+// Test harnesses that pin HOME to a temp root are unaffected: their
+// GC_HOME/log paths sit under that same temp HOME.
+func supervisorLaunchdHomeRootedPathGuard(data *supervisorServiceData) error {
+	homeDir, err := os.UserHomeDir()
+	if err != nil {
+		return fmt.Errorf("resolving home dir for path guard: %w", err)
+	}
+	for _, p := range []struct{ name, val string }{
+		{"GC_HOME", data.GCHome},
+		{"StandardOutPath", data.LogPath},
+		{"StandardErrorPath", data.StderrLogPath},
+	} {
+		if p.val == "" {
+			continue
+		}
+		if !supervisorPathUnder(filepath.Clean(p.val), homeDir) {
+			return fmt.Errorf(
+				"refusing launchd install: %s %q does not resolve under the user home %q — "+
+					"a temp-rooted GC_HOME or log path dies with its harness and loses crash output "+
+					"(integration-test provisioning leak, vp-ry9jm). Set GC_HOME (and the log path) under $HOME.",
+				p.name, p.val, homeDir)
+		}
+	}
+	return nil
+}
