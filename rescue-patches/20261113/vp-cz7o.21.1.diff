+
+func TestEnsureProjectIDRestoresFromCityIdentityMap(t *testing.T) {
+	skipSlowCmdGCTest(t, "requires a managed dolt server; run make test-cmd-gc-process for full coverage")
+
+	const canonicalID = "c3c9af4a-abcd-1234-efgh-000000000001"
+	const rigName = "my-rig"
+
+	makeCityDir := func(t *testing.T, canonicalProjectID string) (cityPath string, scopeRoot string) {
+		t.Helper()
+		cityPath = t.TempDir()
+		toml := "[identity_map]\n" +
+			rigName + " = { project_id = \"" + canonicalProjectID + "\", project = \"my-project\" }\n\n" +
+			"[[rigs]]\nname = \"" + rigName + "\"\n"
+		if err := os.WriteFile(filepath.Join(cityPath, "city.toml"), []byte(toml), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		scopeRoot = filepath.Join(cityPath, rigName)
+		if err := os.MkdirAll(scopeRoot, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		return cityPath, scopeRoot
+	}
+
+	t.Run("L1_absent_L3_eq_L0_restores_canonical", func(t *testing.T) {
+		cityPath, scopeRoot := makeCityDir(t, canonicalID)
+		metadataPath := writeProjectIDMetadataFile(t, scopeRoot, "")
+		port, cleanup := startProjectIDTestServer(t, seedDatabaseProjectIDQueries(canonicalID)...)
+		defer cleanup()
+
+		rec := &projectIdentityRecordingRecorder{}
+		report, err := ensureManagedDoltProjectIDWithRecorder(metadataPath, "127.0.0.1", port, "root", "hq", cityPath, rec)
+		if err != nil {
+			t.Fatalf("ensureManagedDoltProjectIDWithRecorder: %v", err)
+		}
+
+		// After L0 pre-heal, L1=L2=L3=canonicalID → actionNoOp.
+		if report.ProjectID != canonicalID {
+			t.Fatalf("report.ProjectID = %q, want %q", report.ProjectID, canonicalID)
+		}
+		if report.Source != "match" {
+			t.Fatalf("report.Source = %q, want \"match\"", report.Source)
+		}
+
+		// L1 and L2 were written by the pre-heal.
+		assertProjectIdentityFile(t, scopeRoot, canonicalID)
+		assertMetadataProjectID(t, metadataPath, canonicalID)
+
+		// One event was emitted for the pre-heal restore.
+		if len(rec.records) != 1 {
+			t.Fatalf("recorded %d event(s), want 1", len(rec.records))
+		}
+		payloads := decodeProjectIdentityStampedPayloads(t, rec.records)
+		if payloads[0].Source != "restored_from_canonical" {
+			t.Fatalf("event Source = %q, want \"restored_from_canonical\"", payloads[0].Source)
+		}
+		if payloads[0].Layer != "L1" {
+			t.Fatalf("event Layer = %q, want \"L1\"", payloads[0].Layer)
+		}
+		if payloads[0].NewID != canonicalID {
+			t.Fatalf("event NewID = %q, want %q", payloads[0].NewID, canonicalID)
+		}
+	})
+
+	t.Run("L1_wrong_L3_eq_L0_overwrites_wrong_L1", func(t *testing.T) {
+		cityPath, scopeRoot := makeCityDir(t, canonicalID)
+		// Write a wrong L1 — simulates actionGenerate having run before DB recovered.
+		if err := contract.WriteProjectIdentity(fsys.OSFS{}, scopeRoot, "wrong-regenerated-id"); err != nil {
+			t.Fatal(err)
+		}
+		metadataPath := writeProjectIDMetadataFile(t, scopeRoot, "wrong-regenerated-id")
+		port, cleanup := startProjectIDTestServer(t, seedDatabaseProjectIDQueries(canonicalID)...)
+		defer cleanup()
+
+		rec := &projectIdentityRecordingRecorder{}
+		report, err := ensureManagedDoltProjectIDWithRecorder(metadataPath, "127.0.0.1", port, "root", "hq", cityPath, rec)
+		if err != nil {
+			t.Fatalf("ensureManagedDoltProjectIDWithRecorder: %v", err)
+		}
+		if report.ProjectID != canonicalID {
+			t.Fatalf("report.ProjectID = %q, want %q", report.ProjectID, canonicalID)
+		}
+		assertProjectIdentityFile(t, scopeRoot, canonicalID)
+		if len(rec.records) != 1 || decodeProjectIdentityStampedPayloads(t, rec.records)[0].Source != "restored_from_canonical" {
+			t.Fatalf("expected exactly one restored_from_canonical event, got %d events", len(rec.records))
+		}
+	})
+
+	t.Run("L3_neq_L0_no_auto_repair", func(t *testing.T) {
+		// L0 = canonicalID but DB has a different value; pre-heal must not fire.
+		cityPath, scopeRoot := makeCityDir(t, canonicalID)
+		metadataPath := writeProjectIDMetadataFile(t, scopeRoot, "")
+		port, cleanup := startProjectIDTestServer(t, seedDatabaseProjectIDQueries("different-db-id")...)
+		defer cleanup()
+
+		rec := &projectIdentityRecordingRecorder{}
+		report, err := ensureManagedDoltProjectIDWithRecorder(metadataPath, "127.0.0.1", port, "root", "hq", cityPath, rec)
+		if err != nil {
+			t.Fatalf("ensureManagedDoltProjectIDWithRecorder: %v", err)
+		}
+		// No pre-heal: actionAdoptFromL3SeedL2 runs and adopts "different-db-id".
+		if report.ProjectID != "different-db-id" {
+			t.Fatalf("report.ProjectID = %q, want \"different-db-id\"", report.ProjectID)
+		}
+		// L1 should have been seeded with the DB value (not canonicalID).
+		assertProjectIdentityFile(t, scopeRoot, "different-db-id")
+	})
+
+	t.Run("L1_eq_L0_L3_eq_L0_no_op", func(t *testing.T) {
+		cityPath, scopeRoot := makeCityDir(t, canonicalID)
+		if err := contract.WriteProjectIdentity(fsys.OSFS{}, scopeRoot, canonicalID); err != nil {
+			t.Fatal(err)
+		}
+		metadataPath := writeProjectIDMetadataFile(t, scopeRoot, canonicalID)
+		port, cleanup := startProjectIDTestServer(t, seedDatabaseProjectIDQueries(canonicalID)...)
+		defer cleanup()
+
+		rec := &projectIdentityRecordingRecorder{}
+		report, err := ensureManagedDoltProjectIDWithRecorder(metadataPath, "127.0.0.1", port, "root", "hq", cityPath, rec)
+		if err != nil {
+			t.Fatalf("ensureManagedDoltProjectIDWithRecorder: %v", err)
+		}
+		if report.Source != "match" {
+			t.Fatalf("report.Source = %q, want \"match\"", report.Source)
+		}
+		if len(rec.records) != 0 {
+			t.Fatalf("recorded %d event(s), want 0 (no-op)", len(rec.records))
+		}
+	})
+
+	t.Run("no_identity_map_entry_falls_through_to_existing_reconcile", func(t *testing.T) {
+		// city.toml has no [identity_map] section — no-op from L0 perspective;
+		// existing reconcile runs (here: actionAdoptFromL3SeedL2).
+		cityPath := t.TempDir()
+		if err := os.WriteFile(filepath.Join(cityPath, "city.toml"),
+			[]byte("[workspace]\nname = \"demo\"\n\n[[rigs]]\nname = \"my-rig\"\n"),
+			0o644); err != nil {
+			t.Fatal(err)
+		}
+		scopeRoot := filepath.Join(cityPath, rigName)
+		if err := os.MkdirAll(scopeRoot, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		metadataPath := writeProjectIDMetadataFile(t, scopeRoot, "")
+		port, cleanup := startProjectIDTestServer(t, seedDatabaseProjectIDQueries("db-only-id")...)
+		defer cleanup()
+
+		report, err := ensureManagedDoltProjectIDWithRecorder(metadataPath, "127.0.0.1", port, "root", "hq", cityPath, events.Discard)
+		if err != nil {
+			t.Fatalf("ensureManagedDoltProjectIDWithRecorder: %v", err)
+		}
+		// Falls through to actionAdoptFromL3SeedL2.
+		if report.ProjectID != "db-only-id" {
+			t.Fatalf("report.ProjectID = %q, want \"db-only-id\"", report.ProjectID)
+		}
+		assertProjectIdentityFile(t, scopeRoot, "db-only-id")
+	})
+}
