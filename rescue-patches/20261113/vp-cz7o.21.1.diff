@@ -0,0 +1,130 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestReadCityIdentityMapEntry(t *testing.T) {
+	t.Run("absent_city_toml_returns_false", func(t *testing.T) {
+		cityPath := t.TempDir()
+		id, ok, err := readCityIdentityMapEntry(cityPath, filepath.Join(cityPath, "my-rig"))
+		if err != nil {
+			t.Fatalf("err = %v, want nil", err)
+		}
+		if ok || id != "" {
+			t.Fatalf("got (%q, %v), want (\"\", false)", id, ok)
+		}
+	})
+
+	t.Run("empty_city_path_returns_false", func(t *testing.T) {
+		id, ok, err := readCityIdentityMapEntry("", "/any/path")
+		if err != nil {
+			t.Fatalf("err = %v, want nil", err)
+		}
+		if ok || id != "" {
+			t.Fatalf("got (%q, %v), want (\"\", false)", id, ok)
+		}
+	})
+
+	t.Run("no_identity_map_section_returns_false", func(t *testing.T) {
+		cityPath := t.TempDir()
+		if err := os.WriteFile(filepath.Join(cityPath, "city.toml"),
+			[]byte("[workspace]\nname = \"demo\"\n\n[[rigs]]\nname = \"my-rig\"\n"),
+			0o644); err != nil {
+			t.Fatal(err)
+		}
+		id, ok, err := readCityIdentityMapEntry(cityPath, filepath.Join(cityPath, "my-rig"))
+		if err != nil {
+			t.Fatalf("err = %v, want nil", err)
+		}
+		if ok || id != "" {
+			t.Fatalf("got (%q, %v), want (\"\", false)", id, ok)
+		}
+	})
+
+	t.Run("rig_not_in_rigs_table_returns_false", func(t *testing.T) {
+		cityPath := t.TempDir()
+		toml := "[identity_map]\nother-rig = { project_id = \"pid-123\", project = \"p\" }\n\n[[rigs]]\nname = \"other-rig\"\n"
+		if err := os.WriteFile(filepath.Join(cityPath, "city.toml"), []byte(toml), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		id, ok, err := readCityIdentityMapEntry(cityPath, filepath.Join(cityPath, "my-rig"))
+		if err != nil {
+			t.Fatalf("err = %v, want nil", err)
+		}
+		if ok || id != "" {
+			t.Fatalf("got (%q, %v), want (\"\", false)", id, ok)
+		}
+	})
+
+	t.Run("rig_in_rigs_table_but_no_identity_map_entry_returns_false", func(t *testing.T) {
+		cityPath := t.TempDir()
+		toml := "[identity_map]\nother-rig = { project_id = \"pid-123\", project = \"p\" }\n\n[[rigs]]\nname = \"my-rig\"\n"
+		if err := os.WriteFile(filepath.Join(cityPath, "city.toml"), []byte(toml), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		id, ok, err := readCityIdentityMapEntry(cityPath, filepath.Join(cityPath, "my-rig"))
+		if err != nil {
+			t.Fatalf("err = %v, want nil", err)
+		}
+		if ok || id != "" {
+			t.Fatalf("got (%q, %v), want (\"\", false)", id, ok)
+		}
+	})
+
+	t.Run("successful_lookup_returns_project_id", func(t *testing.T) {
+		cityPath := t.TempDir()
+		toml := "[identity_map]\nmy-rig = { project_id = \"c3c9af4a-abcd-1234-efgh-000000000001\", project = \"my-project\" }\n\n[[rigs]]\nname = \"my-rig\"\n"
+		if err := os.WriteFile(filepath.Join(cityPath, "city.toml"), []byte(toml), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		id, ok, err := readCityIdentityMapEntry(cityPath, filepath.Join(cityPath, "my-rig"))
+		if err != nil {
+			t.Fatalf("err = %v, want nil", err)
+		}
+		if !ok || id != "c3c9af4a-abcd-1234-efgh-000000000001" {
+			t.Fatalf("got (%q, %v), want (\"c3c9af4a-abcd-1234-efgh-000000000001\", true)", id, ok)
+		}
+	})
+
+	t.Run("multiple_rigs_resolves_correct_one", func(t *testing.T) {
+		cityPath := t.TempDir()
+		toml := `[identity_map]
+rig-a = { project_id = "pid-aaa", project = "proj-a" }
+rig-b = { project_id = "pid-bbb", project = "proj-b" }
+
+[[rigs]]
+name = "rig-a"
+
+[[rigs]]
+name = "rig-b"
+`
+		if err := os.WriteFile(filepath.Join(cityPath, "city.toml"), []byte(toml), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		id, ok, err := readCityIdentityMapEntry(cityPath, filepath.Join(cityPath, "rig-b"))
+		if err != nil {
+			t.Fatalf("err = %v, want nil", err)
+		}
+		if !ok || id != "pid-bbb" {
+			t.Fatalf("got (%q, %v), want (\"pid-bbb\", true)", id, ok)
+		}
+	})
+
+	t.Run("empty_project_id_returns_false", func(t *testing.T) {
+		cityPath := t.TempDir()
+		toml := "[identity_map]\nmy-rig = { project_id = \"\", project = \"p\" }\n\n[[rigs]]\nname = \"my-rig\"\n"
+		if err := os.WriteFile(filepath.Join(cityPath, "city.toml"), []byte(toml), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		id, ok, err := readCityIdentityMapEntry(cityPath, filepath.Join(cityPath, "my-rig"))
+		if err != nil {
+			t.Fatalf("err = %v, want nil", err)
+		}
+		if ok || id != "" {
+			t.Fatalf("got (%q, %v), want (\"\", false)", id, ok)
+		}
+	})
+}
diff --git a/cmd/gc/dolt_project_id.go b/cmd/gc/dolt_project_id.go
index f5495c2d5..424b48c1b 100644
--- a/cmd/gc/dolt_project_id.go
+++ b/cmd/gc/dolt_project_id.go
@@ -167,6 +167,31 @@ func ensureManagedDoltProjectIDWithRecorder(metadataPath, host, port, user, data
 		return managedDoltProjectIDReport{}, err
 	}
 
+	// L0 pre-heal: if city.toml [identity_map] has a canonical project_id that
+	// the DB (L3) confirms, but L1 is absent or was regenerated to a wrong value,
+	// repair L1 and L2 before reconcile so the subsequent decideReconcile is a
+	// no-op. This closes the recovery gap from vp-cz7o where a rig-clone wipe
+	// caused actionGenerate to stamp a fresh wrong L1 while L3 survived.
+	//
+	// Only fires when L3 == L0 (DB confirms canonical). If L3 != L0, we log and
+	// fall through — a genuine mismatch requires human triage, not auto-repair.
+	if l0, l0ok, l0err := readCityIdentityMapEntry(cityPath, scopeRoot); l0err == nil && l0ok {
+		if ok && databaseProjectID == l0 && (!identityOK || identityProjectID != l0) {
+			if err := contract.WriteProjectIdentity(fs, scopeRoot, l0); err != nil {
+				return managedDoltProjectIDReport{}, fmt.Errorf("L0 pre-heal write identity: %w", err)
+			}
+			if _, err := writeManagedMetadataProjectID(metadataPath, l0); err != nil {
+				return managedDoltProjectIDReport{}, fmt.Errorf("L0 pre-heal write metadata: %w", err)
+			}
+			emitProjectIdentityStampedEvent(rec, cityPath, scopeRoot, "restored_from_canonical", "L1", identityProjectID, l0)
+			identityProjectID, identityOK = l0, true
+			metadataProjectID, metadataOK = l0, true
+		} else if ok && databaseProjectID != l0 {
+			fmt.Fprintf(os.Stderr, "gc dolt-state ensure-project-id: warning: city.toml [identity_map] canonical %q != DB %q for %s; skipping auto-repair\n",
+				l0, databaseProjectID, filepath.Base(scopeRoot))
+		}
+	}
+
 	decision := decideReconcile(identityProjectID, identityOK, metadataProjectID, metadataOK, databaseProjectID, ok)
 	return applyReconcileDecision(ctx, fs, scopeRoot, metadataPath, db, decision, cityPath, rec)
 }
