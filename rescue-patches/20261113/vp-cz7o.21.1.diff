+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/BurntSushi/toml"
+)
+
+type cityIdentityMapEntry struct {
+	ProjectID string `toml:"project_id"`
+	Project   string `toml:"project"`
+}
+
+type cityIdentityMapFile struct {
+	IdentityMap map[string]cityIdentityMapEntry `toml:"identity_map"`
+	Rigs        []struct {
+		Name string `toml:"name"`
+	} `toml:"rigs"`
+}
+
+// readCityIdentityMapEntry returns the canonical project_id for the rig whose
+// directory is scopeRoot. It resolves the rig name by matching
+// filepath.Join(cityPath, rigName) against scopeRoot, then looks it up in the
+// [identity_map] table of city.toml.
+//
+// Returns ("", false, nil) when:
+//   - cityPath is empty
+//   - city.toml is absent or has no [identity_map]
+//   - no [[rigs]] entry resolves to scopeRoot
+//   - the rig has no entry in [identity_map] or the entry has an empty project_id
+//
+// Returns an error only on I/O or TOML parse failures.
+func readCityIdentityMapEntry(cityPath, scopeRoot string) (string, bool, error) {
+	cityPath = strings.TrimSpace(cityPath)
+	if cityPath == "" {
+		return "", false, nil
+	}
+	scopeRoot = filepath.Clean(strings.TrimSpace(scopeRoot))
+
+	data, err := os.ReadFile(filepath.Join(cityPath, "city.toml"))
+	if err != nil {
+		if os.IsNotExist(err) {
+			return "", false, nil
+		}
+		return "", false, err
+	}
+
+	var cfg cityIdentityMapFile
+	if _, err := toml.Decode(string(data), &cfg); err != nil {
+		return "", false, err
+	}
+
+	if len(cfg.IdentityMap) == 0 {
+		return "", false, nil
+	}
+
+	// Resolve rig name: for each [[rigs]] entry compute filepath.Join(cityPath, name)
+	// and compare against scopeRoot. This convention holds for all current Voxist
+	// rigs (all are immediate subdirectories of cityPath). For rigs bound via
+	// site.toml-level paths (not accessible from the minimal struct), this returns
+	// ok=false, preserving full backward compatibility.
+	rigName := ""
+	for _, rig := range cfg.Rigs {
+		if rig.Name == "" {
+			continue
+		}
+		if filepath.Clean(filepath.Join(cityPath, rig.Name)) == scopeRoot {
+			rigName = rig.Name
+			break
+		}
+	}
+	if rigName == "" {
+		return "", false, nil
+	}
+
+	entry, ok := cfg.IdentityMap[rigName]
+	if !ok {
+		return "", false, nil
+	}
+	projectID := strings.TrimSpace(entry.ProjectID)
+	if projectID == "" {
+		return "", false, nil
+	}
+	return projectID, true, nil
+}
diff --git a/cmd/gc/city_identity_map_test.go b/cmd/gc/city_identity_map_test.go
