 // AheadBehindCtx is like AheadBehind but accepts a context.
 func (g *Git) AheadBehindCtx(ctx context.Context) (ahead, behind int, err error) {
 	out, err := g.runCtx(ctx, "rev-list", "--left-right", "--count", "HEAD...@{upstream}")
