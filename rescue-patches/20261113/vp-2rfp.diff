+// TestRunReconciliation_CircuitTripResets_OnRecovery guards that
+// promoteLiveLocked resets circuitTripped so a second live→degraded
+// transition after recovery emits the circuit-breaker trip log again.
+func TestRunReconciliation_CircuitTripResets_OnRecovery(t *testing.T) {
+	backing := &failingScanStore{Store: NewMemStore()}
+	backing.setFailScan(true)
+	cs := NewCachingStoreForTest(backing, nil)
+	cs.state = cacheLive
+
+	var logMu sync.Mutex
+	var logLines []string
+	cs.problemf = func(msg string) {
+		logMu.Lock()
+		logLines = append(logLines, msg)
+		logMu.Unlock()
+	}
+
+	// Phase 1: drive live→degraded; circuit must trip.
+	for i := 0; i < maxCacheSyncFailures; i++ {
+		cs.runReconciliation()
+	}
+	if cs.state != cacheDegraded {
+		t.Fatalf("phase 1: state = %v, want cacheDegraded after %d failures", cs.state, maxCacheSyncFailures)
+	}
+	logMu.Lock()
+	firstTrips := 0
+	for _, l := range logLines {
+		if strings.Contains(l, "circuit-breaker tripped") {
+			firstTrips++
+		}
+	}
+	logLines = logLines[:0]
+	logMu.Unlock()
+	if firstTrips == 0 {
+		t.Fatal("phase 1: expected 'circuit-breaker tripped' log on first live→degraded transition, got none")
+	}
+
+	// Phase 2: recover — backing succeeds, reconcile promotes back to live.
+	backing.setFailScan(false)
+	cs.runReconciliation()
+	if cs.state != cacheLive {
+		t.Fatalf("phase 2: state = %v, want cacheLive after successful recovery reconcile", cs.state)
+	}
+
+	// Phase 3: degrade again — circuit must trip a second time.
+	backing.setFailScan(true)
+	for i := 0; i < maxCacheSyncFailures; i++ {
+		cs.runReconciliation()
+	}
+	if cs.state != cacheDegraded {
+		t.Fatalf("phase 3: state = %v, want cacheDegraded on second failure run", cs.state)
+	}
+
+	logMu.Lock()
+	secondTrips := 0
+	for _, l := range logLines {
+		if strings.Contains(l, "circuit-breaker tripped") {
+			secondTrips++
+		}
+	}
+	logMu.Unlock()
+
+	if secondTrips == 0 {
+		t.Fatal("phase 3: expected 'circuit-breaker tripped' log on second live→degraded transition after recovery, got none — circuitTripped not reset by promoteLiveLocked")
+	}
+}
