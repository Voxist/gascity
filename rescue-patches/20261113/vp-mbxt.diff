@@ -0,0 +1,162 @@
+package main
+
+// CPU runaway watchdog for managed dolt sql-servers.
+//
+// Dolt can enter a CPU spin loop (e.g. DOLT_CLONE against a git code-repo URL)
+// and consume 1000%+ CPU indefinitely, requiring a manual SIGKILL. This
+// watchdog runs as a goroutine alongside the managed server and self-heals the
+// situation: it SIGKILLs the dolt process and lets the supervisor restart it
+// clean.
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+const (
+	// doltCPUWatchdogInterval is how often the watchdog samples the dolt
+	// process's CPU usage. 15 s is fast enough to react in under 90 s while
+	// keeping steady-state CPU cost negligible.
+	doltCPUWatchdogInterval = 15 * time.Second
+
+	// doltCPUWatchdogThreshold is the CPU percentage above which usage is
+	// considered pathological. 200% means the process is consuming 2+ full
+	// CPU cores. Healthy dolt under normal query load stays below 100%; 200%
+	// sustained signals a pathological spin loop (e.g. a stalled DOLT_CLONE).
+	doltCPUWatchdogThreshold = 200.0
+
+	// doltCPUWatchdogSustainedSamples is the minimum number of consecutive
+	// samples above doltCPUWatchdogThreshold before the watchdog kills. At
+	// the default 15 s interval this requires 60 s of sustained high CPU,
+	// protecting against a single DOLT_MERGE burst that legitimately peaks
+	// above the threshold.
+	doltCPUWatchdogSustainedSamples = 4
+
+	// doltCPUWatchdogEnv disables the CPU watchdog when set to "0".
+	doltCPUWatchdogEnv = "GC_DOLT_CPU_WATCHDOG"
+
+	// doltCPUWatchdogIntervalEnv overrides the sample interval in
+	// milliseconds, used in tests to avoid wall-clock waits.
+	doltCPUWatchdogIntervalEnv = "GC_DOLT_CPU_WATCHDOG_INTERVAL_MS"
+)
+
+// doltCPUWatchdogEnabled reports whether the CPU watchdog is active.
+// Default on; opt out with GC_DOLT_CPU_WATCHDOG=0.
+func doltCPUWatchdogEnabled() bool {
+	return strings.TrimSpace(os.Getenv(doltCPUWatchdogEnv)) != "0"
+}
+
+// doltCPUWatchdogResolvedInterval returns the sample interval, honoring the
+// millisecond test override when it parses to a positive value.
+func doltCPUWatchdogResolvedInterval() time.Duration {
+	raw := strings.TrimSpace(os.Getenv(doltCPUWatchdogIntervalEnv))
+	if raw == "" {
+		return doltCPUWatchdogInterval
+	}
+	ms, err := strconv.Atoi(raw)
+	if err != nil || ms <= 0 {
+		return doltCPUWatchdogInterval
+	}
+	return time.Duration(ms) * time.Millisecond
+}
+
+// doltCPUSample reads the current CPU% for pid via `ps -o pcpu= -p <pid>`.
+// Returns (pct, nil) on success. Returns (-1, nil) when the process no
+// longer exists (ps exits non-zero). Returns (-1, err) on unexpected parse
+// errors.
+//
+// `ps -o pcpu=` reports accumulated CPU as a percentage of one CPU core. On
+// multi-core machines a multi-threaded process can legitimately show > 100%.
+// The value is the same semantics on Darwin and Linux.
+func doltCPUSample(pid int) (float64, error) {
+	out, err := exec.Command("ps", "-o", "pcpu=", "-p", strconv.Itoa(pid)).Output()
+	if err != nil {
+		// ps exits non-zero when the PID is not found; treat as gone.
+		return -1, nil
+	}
+	val := strings.TrimSpace(string(out))
+	if val == "" {
+		return -1, nil
+	}
+	pct, err := strconv.ParseFloat(val, 64)
+	if err != nil {
+		return -1, fmt.Errorf("dolt cpu watchdog: parse pcpu %q for pid %d: %w", val, pid, err)
+	}
+	return pct, nil
+}
+
+// doltCPUKillEvent is sent on the cpuKill channel when the watchdog fires.
+type doltCPUKillEvent struct {
+	PeakCPU   float64
+	DurationS int // approximate sustained seconds = highStreak * interval
+}
+
+// runDoltCPUWatchdog starts the CPU watchdog as a goroutine. Call it inside
+// runManagedDoltScopeWatchdog after the dolt process starts. When it detects
+// sustained high CPU it SIGKILLs the process and sends an event on cpuKill.
+// Close stop to signal a clean shutdown (e.g. when dolt exits normally).
+func runDoltCPUWatchdog(pid int, logFile *os.File, interval time.Duration, cpuKill chan<- doltCPUKillEvent, stop <-chan struct{}) {
+	runDoltCPUWatchdogWithSampler(pid, logFile, interval, cpuKill, stop, doltCPUSample)
+}
+
+// runDoltCPUWatchdogWithSampler is the testable inner implementation; it
+// accepts an injectable sampler so unit tests can drive CPU values without
+// spawning a real process.
+func runDoltCPUWatchdogWithSampler(
+	pid int,
+	logFile *os.File,
+	interval time.Duration,
+	cpuKill chan<- doltCPUKillEvent,
+	stop <-chan struct{},
+	sampler func(int) (float64, error),
+) {
+	highStreak := 0
+	peakCPU := 0.0
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-ticker.C:
+			pct, err := sampler(pid)
+			if err != nil {
+				fmt.Fprintf(logFile, "gc cpu watchdog: sample error pid %d: %v\n", pid, err) //nolint:errcheck
+				highStreak = 0
+				peakCPU = 0
+				continue
+			}
+			if pct < 0 {
+				// Process already gone; nothing left to watch.
+				return
+			}
+			if pct > doltCPUWatchdogThreshold {
+				highStreak++
+				if pct > peakCPU {
+					peakCPU = pct
+				}
+			} else {
+				highStreak = 0
+				peakCPU = 0
+			}
+			if highStreak >= doltCPUWatchdogSustainedSamples {
+				durationS := int(float64(highStreak) * interval.Seconds())
+				fmt.Fprintf(logFile, //nolint:errcheck
+					"gc cpu watchdog: ALERT severity=critical source=dolt-cpu-watchdog "+
+						"dolt_pid=%d cpu_pct=%.1f duration_s=%d; sending SIGKILL\n",
+					pid, peakCPU, durationS)
+				_ = syscall.Kill(pid, syscall.SIGKILL)
+				select {
+				case cpuKill <- doltCPUKillEvent{PeakCPU: peakCPU, DurationS: durationS}:
+				default:
+				}
+				return
+			}
+		}
+	}
+}
diff --git a/cmd/gc/dolt_cpu_watchdog_test.go b/cmd/gc/dolt_cpu_watchdog_test.go
