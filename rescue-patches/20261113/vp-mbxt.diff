@@ -0,0 +1,284 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+const testWatchdogInterval = 10 * time.Millisecond
+
+// samplersAbove returns a sampler that always reports cpuPct.
+func samplersAbove(cpuPct float64) func(int) (float64, error) {
+	return func(_ int) (float64, error) { return cpuPct, nil }
+}
+
+// samplersSequence returns a sampler that returns pcts[i] on the i-th call,
+// clamping at pcts[len-1] for subsequent calls.
+func samplersSequence(pcts []float64) func(int) (float64, error) {
+	i := 0
+	return func(_ int) (float64, error) {
+		v := pcts[i]
+		if i < len(pcts)-1 {
+			i++
+		}
+		return v, nil
+	}
+}
+
+// newTestLogFile creates a temp log file in t.TempDir() and returns it.
+func newTestLogFile(t *testing.T) *os.File {
+	t.Helper()
+	f, err := os.Create(filepath.Join(t.TempDir(), "watchdog.log"))
+	if err != nil {
+		t.Fatalf("create log file: %v", err)
+	}
+	t.Cleanup(func() { f.Close() }) //nolint:errcheck
+	return f
+}
+
+// readLogFile returns the content of the log file.
+func readLogFile(t *testing.T, f *os.File) string {
+	t.Helper()
+	if _, err := f.Seek(0, 0); err != nil {
+		t.Fatalf("seek log file: %v", err)
+	}
+	b, err := os.ReadFile(f.Name())
+	if err != nil {
+		t.Fatalf("read log file: %v", err)
+	}
+	return string(b)
+}
+
+// TestDoltCPUWatchdog_KillsAfterSustainedHighCPU verifies that
+// doltCPUWatchdogSustainedSamples consecutive high-CPU samples cause a kill
+// event to be sent and a structured alert to be logged.
+func TestDoltCPUWatchdog_KillsAfterSustainedHighCPU(t *testing.T) {
+	logFile := newTestLogFile(t)
+	cpuKill := make(chan doltCPUKillEvent, 1)
+	stop := make(chan struct{})
+	defer close(stop)
+
+	// A non-existent PID — the kill syscall will fail silently, which is
+	// fine: we test watchdog logic, not the OS kill.
+	const fakePID = 99999
+
+	go runDoltCPUWatchdogWithSampler(
+		fakePID, logFile, testWatchdogInterval, cpuKill, stop,
+		samplersAbove(doltCPUWatchdogThreshold+100),
+	)
+
+	select {
+	case ev := <-cpuKill:
+		if ev.PeakCPU <= doltCPUWatchdogThreshold {
+			t.Errorf("PeakCPU %.1f <= threshold %.1f", ev.PeakCPU, doltCPUWatchdogThreshold)
+		}
+		if ev.DurationS < 0 {
+			t.Errorf("DurationS %d; want >= 0", ev.DurationS)
+		}
+		log := readLogFile(t, logFile)
+		if !strings.Contains(log, "ALERT") {
+			t.Errorf("watchdog log missing ALERT; got:\n%s", log)
+		}
+		if !strings.Contains(log, "severity=critical") {
+			t.Errorf("watchdog log missing severity=critical; got:\n%s", log)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("watchdog did not fire after sustained high CPU")
+	}
+}
+
+// TestDoltCPUWatchdog_NokillOnBurstOneHighSample verifies that a single
+// sample above the threshold does not trigger a kill (burst protection).
+func TestDoltCPUWatchdog_NokillOnBurstOneHighSample(t *testing.T) {
+	logFile := newTestLogFile(t)
+	cpuKill := make(chan doltCPUKillEvent, 1)
+	stop := make(chan struct{})
+
+	// One high sample, then drop below threshold.
+	bursts := make([]float64, doltCPUWatchdogSustainedSamples+4)
+	bursts[0] = doltCPUWatchdogThreshold + 50
+	for i := 1; i < len(bursts); i++ {
+		bursts[i] = 50.0
+	}
+
+	go runDoltCPUWatchdogWithSampler(
+		99999, logFile, testWatchdogInterval, cpuKill, stop,
+		samplersSequence(bursts),
+	)
+
+	// Allow enough ticks to cover a sustained run if it were to fire.
+	time.Sleep(time.Duration(doltCPUWatchdogSustainedSamples+3) * testWatchdogInterval * 3)
+	close(stop)
+
+	select {
+	case <-cpuKill:
+		t.Error("watchdog fired on a single-sample burst; expected no kill")
+	default:
+	}
+}
+
+// TestDoltCPUWatchdog_StreakResetOnNormalSample verifies that the sustained
+// streak resets when a normal sample interrupts high-CPU samples.
+func TestDoltCPUWatchdog_StreakResetOnNormalSample(t *testing.T) {
+	logFile := newTestLogFile(t)
+	cpuKill := make(chan doltCPUKillEvent, 1)
+	stop := make(chan struct{})
+
+	// Pattern: (threshold-1) highs, one low, (threshold-1) highs → no kill.
+	n := doltCPUWatchdogSustainedSamples - 1
+	pcts := make([]float64, 0, n+1+n+4)
+	for i := 0; i < n; i++ {
+		pcts = append(pcts, doltCPUWatchdogThreshold+10)
+	}
+	pcts = append(pcts, 50.0) // reset
+	for i := 0; i < n; i++ {
+		pcts = append(pcts, doltCPUWatchdogThreshold+10)
+	}
+	for i := 0; i < 4; i++ {
+		pcts = append(pcts, 50.0) // stay low to drain
+	}
+
+	go runDoltCPUWatchdogWithSampler(
+		99999, logFile, testWatchdogInterval, cpuKill, stop,
+		samplersSequence(pcts),
+	)
+
+	time.Sleep(time.Duration(len(pcts)+2) * testWatchdogInterval * 3)
+	close(stop)
+
+	select {
+	case <-cpuKill:
+		t.Error("watchdog fired after streak reset; expected no kill")
+	default:
+	}
+}
+
+// TestDoltCPUWatchdog_StopChannelExitsCleanly verifies the goroutine exits
+// when the stop channel is closed.
+func TestDoltCPUWatchdog_StopChannelExitsCleanly(t *testing.T) {
+	logFile := newTestLogFile(t)
+	cpuKill := make(chan doltCPUKillEvent, 1)
+	stop := make(chan struct{})
+
+	exited := make(chan struct{})
+	go func() {
+		defer close(exited)
+		runDoltCPUWatchdogWithSampler(
+			99999, logFile, testWatchdogInterval, cpuKill, stop,
+			samplersAbove(0.0),
+		)
+	}()
+
+	close(stop)
+	select {
+	case <-exited:
+	case <-time.After(2 * time.Second):
+		t.Fatal("watchdog goroutine did not exit after stop channel closed")
+	}
+}
+
+// TestDoltCPUWatchdog_ProcessGoneExitsCleanly verifies the goroutine exits
+// when the sampler reports the process is gone (pct < 0).
+func TestDoltCPUWatchdog_ProcessGoneExitsCleanly(t *testing.T) {
+	logFile := newTestLogFile(t)
+	cpuKill := make(chan doltCPUKillEvent, 1)
+	stop := make(chan struct{})
+	defer close(stop)
+
+	exited := make(chan struct{})
+	go func() {
+		defer close(exited)
+		runDoltCPUWatchdogWithSampler(
+			99999, logFile, testWatchdogInterval, cpuKill, stop,
+			func(_ int) (float64, error) { return -1.0, nil },
+		)
+	}()
+
+	select {
+	case <-exited:
+	case <-time.After(2 * time.Second):
+		t.Fatal("watchdog goroutine did not exit when process is gone")
+	}
+}
+
+// TestDoltCPUWatchdog_AlertLogContainsFields verifies the structured alert
+// log line contains the expected fields.
+func TestDoltCPUWatchdog_AlertLogContainsFields(t *testing.T) {
+	logFile := newTestLogFile(t)
+	cpuKill := make(chan doltCPUKillEvent, 1)
+	stop := make(chan struct{})
+	defer close(stop)
+
+	go runDoltCPUWatchdogWithSampler(
+		42, logFile, testWatchdogInterval, cpuKill, stop,
+		samplersAbove(doltCPUWatchdogThreshold+1),
+	)
+
+	select {
+	case <-cpuKill:
+	case <-time.After(5 * time.Second):
+		t.Fatal("watchdog did not fire")
+	}
+
+	log := readLogFile(t, logFile)
+	for _, want := range []string{
+		"ALERT",
+		"severity=critical",
+		"source=dolt-cpu-watchdog",
+		"dolt_pid=42",
+		"cpu_pct=",
+		"duration_s=",
+		"SIGKILL",
+	} {
+		if !strings.Contains(log, want) {
+			t.Errorf("alert log missing %q; got:\n%s", want, log)
+		}
+	}
+}
+
+// TestDoltCPUWatchdogEnabled verifies the env-var gate.
+func TestDoltCPUWatchdogEnabled(t *testing.T) {
+	t.Run("enabled by default", func(t *testing.T) {
+		t.Setenv(doltCPUWatchdogEnv, "")
+		if !doltCPUWatchdogEnabled() {
+			t.Error("expected enabled by default")
+		}
+	})
+	t.Run("disabled by 0", func(t *testing.T) {
+		t.Setenv(doltCPUWatchdogEnv, "0")
+		if doltCPUWatchdogEnabled() {
+			t.Error("expected disabled when env=0")
+		}
+	})
+	t.Run("enabled by non-zero", func(t *testing.T) {
+		t.Setenv(doltCPUWatchdogEnv, "1")
+		if !doltCPUWatchdogEnabled() {
+			t.Error("expected enabled when env=1")
+		}
+	})
+}
+
+// TestDoltCPUWatchdogResolvedInterval verifies the env-var override.
+func TestDoltCPUWatchdogResolvedInterval(t *testing.T) {
+	t.Run("default when unset", func(t *testing.T) {
+		t.Setenv(doltCPUWatchdogIntervalEnv, "")
+		if got := doltCPUWatchdogResolvedInterval(); got != doltCPUWatchdogInterval {
+			t.Errorf("got %v; want %v", got, doltCPUWatchdogInterval)
+		}
+	})
+	t.Run("override via env", func(t *testing.T) {
+		t.Setenv(doltCPUWatchdogIntervalEnv, "250")
+		if got := doltCPUWatchdogResolvedInterval(); got != 250*time.Millisecond {
+			t.Errorf("got %v; want 250ms", got)
+		}
+	})
+	t.Run("default on invalid env", func(t *testing.T) {
+		t.Setenv(doltCPUWatchdogIntervalEnv, "notanumber")
+		if got := doltCPUWatchdogResolvedInterval(); got != doltCPUWatchdogInterval {
+			t.Errorf("got %v; want %v", got, doltCPUWatchdogInterval)
+		}
+	})
+}
