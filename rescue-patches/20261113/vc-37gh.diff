diff --git a/internal/beads/caching_store_deps_complete_gauge_internal_test.go b/internal/beads/caching_store_deps_complete_gauge_internal_test.go
new file mode 100644
index 000000000..3ae8c6cd6
--- /dev/null
+++ b/internal/beads/caching_store_deps_complete_gauge_internal_test.go
@@ -0,0 +1,111 @@
+package beads
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+// ADR-0094 D6 AC1/AC3. These assert the three properties that separate a
+// USEFUL depsComplete gauge from a boolean that reports "false" and leaves the
+// defect exactly as invisible as it was before -- the failure mode vc-vlyk was
+// opened to stop, where a guard is satisfiable without covering the condition.
+
+// A latch and a ping-pong present identically to a sampled boolean: both read
+// false. They are told apart by dwell holding while the false-write count
+// climbs, which is why the setter must not re-stamp Since on a redundant write.
+func TestDepsCompleteGaugeDistinguishesLatchFromPingPong(t *testing.T) {
+	c := &CachingStore{}
+
+	c.setDepsCompleteLocked(true, depsDriverPrime)
+	if !c.stats.DepsComplete {
+		t.Fatal("DepsComplete = false after a true write")
+	}
+	stampAfterTrue := c.stats.DepsCompleteSince
+	if stampAfterTrue.IsZero() {
+		t.Fatal("DepsCompleteSince unstamped after the first write: dwell is unmeasurable")
+	}
+
+	c.setDepsCompleteLocked(false, depsDriverReconcile)
+	falseAt := c.stats.DepsCompleteSince
+	if !falseAt.After(stampAfterTrue) {
+		t.Fatal("DepsCompleteSince did not advance on the true->false transition")
+	}
+	if got := c.stats.DepsCompleteFalseWrites; got != 1 {
+		t.Fatalf("DepsCompleteFalseWrites = %d, want 1", got)
+	}
+
+	// Nine more reconcile passes, each folding false again. This is the shape
+	// a per-tick ping-pong actually has, and the dwell must survive it: if
+	// Since were re-stamped here, ADR-0094's "latched false for > 1h" trigger
+	// could never fire no matter how long the condition held.
+	for i := 0; i < 9; i++ {
+		c.setDepsCompleteLocked(false, depsDriverReconcile)
+	}
+	if c.stats.DepsCompleteSince != falseAt {
+		t.Fatalf("DepsCompleteSince moved on a redundant false write (%v -> %v): the >1h trigger becomes unreachable",
+			falseAt, c.stats.DepsCompleteSince)
+	}
+	if got := c.stats.DepsCompleteFalseWrites; got != 10 {
+		t.Fatalf("DepsCompleteFalseWrites = %d, want 10: redundant writes are the ping-pong signal", got)
+	}
+}
+
+// Deliverable #3 is "identify the surviving driver", so the gauge has to name
+// the writer. Each of the six sites reports itself.
+func TestDepsCompleteGaugeAttributesTheWritingSite(t *testing.T) {
+	for _, driver := range []string{
+		depsDriverPrime,
+		depsDriverPartialPrime,
+		depsDriverReconcile,
+		depsDriverEventDepsStale,
+		depsDriverEventMissing,
+		depsDriverEventOther,
+	} {
+		c := &CachingStore{}
+		c.setDepsCompleteLocked(false, driver)
+		if got := c.stats.DepsCompleteDriver; got != driver {
+			t.Fatalf("DepsCompleteDriver = %q, want %q", got, driver)
+		}
+		if got := c.depsCompleteDriverLocked(); got != driver {
+			t.Fatalf("depsCompleteDriverLocked = %q, want %q", got, driver)
+		}
+	}
+}
+
+// AC1: observable without a debugger. The value has to reach the one periodic
+// per-rig line an operator greps on a running supervisor.
+func TestReconcileHeartbeatCarriesDepsCompleteGauge(t *testing.T) {
+	c := &CachingStore{idPrefix: "vc"}
+	now := time.Now()
+
+	// Before any write the dwell is unknown, not zero: a fresh process must not
+	// read as a long-held latch.
+	if got := c.depsCompleteDwellLocked(now); got != "unknown" {
+		t.Fatalf("dwell before any write = %q, want %q", got, "unknown")
+	}
+	if got := c.depsCompleteDriverLocked(); got != "none" {
+		t.Fatalf("driver before any write = %q, want %q", got, "none")
+	}
+
+	c.setDepsCompleteLocked(false, depsDriverReconcile)
+	c.setDepsCompleteLocked(false, depsDriverReconcile)
+
+	line, ok := c.reconcileSuccessLogLocked(now.Add(90*time.Second), 42*time.Millisecond, 1, 2, 3)
+	if !ok {
+		t.Fatal("reconcileSuccessLogLocked suppressed the first heartbeat")
+	}
+	for _, want := range []string{
+		"depsComplete=false",
+		"depsDriver=" + depsDriverReconcile,
+		"depsFalseWrites=2",
+		"depsFor=",
+	} {
+		if !strings.Contains(line, want) {
+			t.Fatalf("heartbeat line missing %q\nline: %s", want, line)
+		}
+	}
+	if strings.Contains(line, "depsFor=unknown") {
+		t.Fatalf("dwell reported unknown after a write\nline: %s", line)
+	}
+}
