+// depsComplete write-site names, recorded on CacheStats.DepsCompleteDriver.
+// ADR-0094 D6 asks not just whether depsComplete is false but WHICH site keeps
+// making it false, so every writer identifies itself.
+const (
+	// depsDriverPrime: full cache rebuild folded the backing store's own
+	// completeness verdict (fetchDepsForBeads) with the dep-fetch error.
+	depsDriverPrime = "prime"
+	// depsDriverPartialPrime: a partial prime cannot claim whole-store dep
+	// coverage, so it writes false unconditionally.
+	depsDriverPartialPrime = "partial-prime"
+	// depsDriverReconcile: a reconcile pass folded its fetch verdict with any
+	// per-row degradeDepsComplete decision (coverage hole, or a recency-keep
+	// whose retained deps diverge from the fresh snapshot).
+	depsDriverReconcile = "reconcile"
+	// depsDriverEventDepsStale: a bead.updated whose payload looked complete
+	// but was not refreshed from the backing, so bd's on_update hook may have
+	// omitted dependencies after a removal.
+	depsDriverEventDepsStale = "event-deps-stale"
+	// depsDriverEventMissing: a bead.updated for a row the cache had no deps
+	// entry for while claiming completeness.
+	depsDriverEventMissing = "event-missing-deps"
+	// depsDriverEventOther: any other event type for a row with no cached deps
+	// entry.
+	depsDriverEventOther = "event-other"
+)
+
+// setDepsCompleteLocked is the ONLY writer of c.depsComplete.
+//
+// Routing all six sites through one setter is what makes ADR-0094 D6
+// answerable. The useful question is not "is depsComplete false" -- a single
+// sampled boolean answers that and still leaves the defect invisible, which is
+// how D6's own trigger condition sat unevaluable for six days. The question is
+// which site keeps writing false, and whether the value is LATCHED or
+// PING-PONGING. Those need three things a boolean does not carry: the last
+// writer's identity, the dwell in the current value, and a count of false
+// writes.
+//
+// Since is stamped only on a real transition. Re-stamping it whenever an
+// already-false value is written false again would reset the dwell on every
+// reconcile tick and make "latched false for > 1h" unreachable no matter how
+// long the latch held -- the precise reason that trigger has never fired.
+// DepsCompleteFalseWrites absorbs the redundant writes instead, so a latch
+// (dwell grows, count flat) and a ping-pong (dwell grows, count climbs per
+// tick) stay distinguishable.
+//
+// Caller must hold c.mu.
+func (c *CachingStore) setDepsCompleteLocked(v bool, driver string) {
+	if !v {
+		c.stats.DepsCompleteFalseWrites++
+	}
+	c.stats.DepsCompleteDriver = driver
+	// Stamp on the first write as well as on every real transition. A zero
+	// Since is the "never written" sentinel, and depsComplete's zero value is
+	// already false -- so without this clause a store that primes false and
+	// stays false would short-circuit on every write and report its dwell as
+	// unknown forever, which is the exact reading the >1h trigger needs and the
+	// exact case it would most need it in.
+	if c.depsComplete == v && !c.stats.DepsCompleteSince.IsZero() {
+		return
+	}
+	c.depsComplete = v
+	c.stats.DepsComplete = v
+	c.stats.DepsCompleteSince = time.Now()
+}
