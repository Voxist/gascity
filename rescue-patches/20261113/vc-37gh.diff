+// depsCompleteDwellLocked renders how long depsComplete has held its current
+// value. "unknown" until the first write stamps it, so a fresh process is never
+// misread as a long-held latch. Caller must hold c.mu.
+func (c *CachingStore) depsCompleteDwellLocked(now time.Time) string {
+	if c.stats.DepsCompleteSince.IsZero() {
+		return "unknown"
+	}
+	return now.Sub(c.stats.DepsCompleteSince).Round(time.Second).String()
+}
+
+// depsCompleteDriverLocked names the last site to write depsComplete, or
+// "none" before any write. Caller must hold c.mu.
+func (c *CachingStore) depsCompleteDriverLocked() string {
+	if c.stats.DepsCompleteDriver == "" {
+		return "none"
+	}
+	return c.stats.DepsCompleteDriver
+}
