#!/usr/bin/env bash
#
# Slice the non-cmd/gc unit-cover package list into one matrix shard.
#
# Reads the full package list on stdin (one import path per line) and writes
# this shard's slice to stdout. Assignment is modulo over the input order, the
# same rule scripts/test-integration-shard uses, so the shards PARTITION the
# list: every package lands in exactly one shard and none is dropped.
#
# That property is the point. A slicer that loses a package does not fail — it
# silently removes those tests and their coverage while every shard still
# reports success. scripts/noncmdgc_shard_test.go pins union and disjointness.
#
# usage: noncmdgc-shard-packages <shard-index> <shard-total> < packages

set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <shard-index> <shard-total> < packages" >&2
  exit 1
fi

shard_index="$1"
shard_total="$2"

if ! [[ "$shard_index" =~ ^[0-9]+$ && "$shard_total" =~ ^[0-9]+$ ]]; then
  echo "shard index and total must be positive integers (got ${shard_index} of ${shard_total})" >&2
  exit 1
fi
if (( shard_total < 1 || shard_index < 1 || shard_index > shard_total )); then
  echo "invalid shard ${shard_index} of ${shard_total}" >&2
  exit 1
fi

awk -v idx="$shard_index" -v total="$shard_total" '
  NF == 0 { next }
  { if ((n++ % total) == idx - 1) print }
'
