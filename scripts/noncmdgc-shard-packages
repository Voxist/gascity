#!/usr/bin/env bash
#
# Slice the non-cmd/gc unit-cover package list into one matrix shard.
#
# Reads the full package list on stdin (one import path per line) and writes
# this shard's slice to stdout. Assignment is modulo over the input order, the
# same rule scripts/test-integration-shard uses, so the shards PARTITION the
# list: every package lands in exactly one shard and none is dropped.
#
# That property is the point. A slicer that loses a package does not fail — it
# silently removes those tests and their coverage while every shard still
# reports success. An empty slice is therefore an error, not an empty run: it
# means the shard bounds do not match the package list. The union and
# disjointness of the shards are pinned by TestNoncmdgcShardPartitionsThePackageList
# in scripts/test_go_test_shard_test.go, which reuses that file's shardTestCommand
# helper so this script adds no untagged subprocess call site to the resource census.
#
# usage: noncmdgc-shard-packages <shard-index> <shard-total> < packages

set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <shard-index> <shard-total> < packages" >&2
  exit 1
fi

shard_index="$1"
shard_total="$2"

if ! [[ "$shard_index" =~ ^[0-9]+$ && "$shard_total" =~ ^[0-9]+$ ]]; then
  echo "shard index and total must be positive integers (got ${shard_index} of ${shard_total})" >&2
  exit 1
fi
if (( shard_total < 1 || shard_index < 1 || shard_index > shard_total )); then
  echo "invalid shard ${shard_index} of ${shard_total}" >&2
  exit 1
fi

selected="$(awk -v idx="$shard_index" -v total="$shard_total" '
  NF == 0 { next }
  { if ((n++ % total) == idx - 1) print }
')"

# An empty slice means the bounds do not match the input (an empty package list,
# or more shards than packages). Printing nothing would make the caller run
# `go test` with no package arguments, which succeeds having tested nothing.
if [[ -z "$selected" ]]; then
  echo "no packages selected for shard ${shard_index} of ${shard_total}" >&2
  exit 1
fi

printf '%s\n' "$selected"
