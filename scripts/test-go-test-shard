#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: $0 <package> <shard-index> <shard-total>" >&2
  exit 1
fi

test_pkg="$1"
shard_index="$2"
shard_total="$3"

if ! [[ "$shard_index" =~ ^[0-9]+$ && "$shard_total" =~ ^[0-9]+$ ]]; then
  echo "shard index and total must be positive integers" >&2
  exit 1
fi
if (( shard_index < 1 || shard_total < 1 || shard_index > shard_total )); then
  echo "invalid shard ${shard_index} of ${shard_total}" >&2
  exit 1
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# One shared seeded gitconfig for every nested test env; resolved once so the
# env -i block below cannot drift from the Makefile (scripts/test-gitconfig-path).
gc_test_gitconfig="$("$repo_root/scripts/test-gitconfig-path")"
source "$repo_root/scripts/lib/common.sh"
# shellcheck source=lib/test-slice.sh
source "$repo_root/scripts/lib/test-slice.sh"
gc_test_slice_reexec "$repo_root/scripts/test-go-test-shard" "$@"
# shellcheck source=lib/harness-reap.sh
source "$repo_root/scripts/lib/harness-reap.sh"

# Live progress, opt-in with GO_TEST_SHARD_PROGRESS=1 (the fork's macOS
# cmd-gc process shards; ga-05vt3.12). A shard cancelled at its job cap prints
# nothing on its own: go's -timeout starts only once the test binary runs, and
# `go test -list` before it is under no budget at all, so a nightly that lost
# every shard to the cap showed only the make line. With progress on, the
# shard instead
#   - times its phases apart: the compile and link (`go test -c`), the
#     discovery run of that binary under -test.list (which runs TestMain), and
#     the product run, whose first `=== RUN` line marks the end of its own
#     link and TestMain setup;
#   - runs the product with -v, so each test's start and end reach the log as
#     they happen (the log stamps every line);
#   - prints a heartbeat every GO_TEST_SHARD_PROGRESS_INTERVAL seconds
#     (default 180) with the shard's live process tree and each process's
#     resident memory, naming what it is compiling or which test binary is
#     running, and the host's swap use;
#   - once GO_TEST_SHARD_PROGRESS_QUIT_AFTER (an <n>[s|m|h] duration from the
#     shard's start) has passed, sends SIGQUIT once to every live test binary
#     in that tree, so a shard about to be cancelled dumps its goroutine stacks
#     into the log first.
# Off, the shard runs exactly as it does without these lines.
progress="${GO_TEST_SHARD_PROGRESS:-0}"
progress_start="$(date +%s)"
progress_pid=""
progress_dir=""

gc_shard_progress() {
  [[ "$progress" == 1 ]] || return 0
  printf '[shard-progress %s +%ss] %s\n' "$(date -u +%H:%M:%SZ)" "$(( $(date +%s) - progress_start ))" "$*"
}

# gc_shard_progress_tree prints every live descendant of this shell, one per
# line as "pid ppid rss-KiB elapsed command", the command cut to 240
# characters (a chunk's -run regex alone can run to 120 KiB).
gc_shard_progress_tree() {
  ps -A -o pid=,ppid=,rss=,etime=,command= 2>/dev/null | awk -v root="$$" '
    { n++; pid[n] = $1; ppid[n] = $2; line[n] = $0 }
    END {
      want[root] = 1
      do {
        grew = 0
        for (i = 1; i <= n; i++) {
          if (!(pid[i] in want) && (ppid[i] in want)) { want[pid[i]] = 1; grew = 1 }
        }
      } while (grew)
      for (i = 1; i <= n; i++) {
        if (pid[i] != root && (pid[i] in want)) {
          l = line[i]; sub(/^ +/, "", l); print substr(l, 1, 240)
        }
      }
    }'
}

gc_shard_progress_heartbeat() {
  local interval="$1" quit_after="$2" signaled=" " tree swap pid command arg
  trap 'exit 0' TERM
  while :; do
    # sleep holds neither output stream, so one left running when this loop
    # is stopped cannot keep the caller's log pipe open.
    sleep "$interval" >/dev/null 2>&1 &
    wait "$!" || true
    # A shard that exits without stopping this loop (a signal landing before
    # progress_pid was recorded) must not leave it beating forever.
    kill -0 "$$" 2>/dev/null || exit 0
    tree="$(gc_shard_progress_tree)"
    gc_shard_progress "heartbeat; live processes (pid ppid rss-KiB elapsed command):"
    printf '%s\n' "$tree" | sed 's/^/    /'
    # Swap in use is the sign of a compile or test outgrowing the runner's
    # memory (macOS; elsewhere the line is left out).
    swap="$(sysctl -n vm.swapusage 2>/dev/null || true)"
    if [[ -n "$swap" ]]; then
      gc_shard_progress "swap: ${swap}"
    fi
    if [[ -n "$quit_after" ]] && (( $(date +%s) - progress_start >= quit_after )); then
      # A test binary is a command named *.test, or a script of that name run
      # by its interpreter. Each is signalled once; one still compiling when
      # the time passes is caught on a later beat.
      while read -r pid _ _ _ command arg _; do
        case "$command" in
          *.test) ;;
          *) case "$arg" in *.test) command="$arg" ;; *) continue ;; esac ;;
        esac
        case "$signaled" in *" ${pid} "*) continue ;; esac
        signaled+="${pid} "
        gc_shard_progress "past GO_TEST_SHARD_PROGRESS_QUIT_AFTER: SIGQUIT to $(basename "$command") (pid ${pid}) for a goroutine dump"
        kill -QUIT "$pid" 2>/dev/null || true
      done <<< "$tree"
    fi
  done
}

gc_shard_progress_stop() {
  if [[ -n "$progress_pid" ]]; then
    kill -TERM "$progress_pid" 2>/dev/null || true
    wait "$progress_pid" 2>/dev/null || true
    progress_pid=""
  fi
  if [[ -n "$progress_dir" ]]; then
    rm -rf "$progress_dir"
    progress_dir=""
  fi
}

# This shard owns its product run's process tree. Without these traps a
# terminated runner leaves the test binary running under init, which is how
# kit-k72d ended up paying ~1 core for 5h34m (gas-px0). The signal traps tear
# down the run and its watchdog, then re-raise, so the runner's own exit
# status still reports the signal to its caller.
gc_shard_on_signal() {
  local sig="$1"
  gc_shard_progress_stop
  gc_harness_terminate_supervised
  trap - "$sig"
  kill -"$sig" $$
}
trap 'gc_shard_progress_stop; gc_harness_terminate_supervised' EXIT
trap 'gc_shard_on_signal INT' INT
trap 'gc_shard_on_signal TERM' TERM
trap 'gc_shard_on_signal HUP' HUP

timeout="${GO_TEST_TIMEOUT:-20m}"

gopath_val="$(go env GOPATH)"
gocache_val="$(go env GOCACHE)"
gomodcache_val="$(go env GOMODCACHE)"
gotmpdir_val="$(go env GOTMPDIR)"
goroot_val="$(go env GOROOT)"

# Mirror the Makefile's CGO path detection here so tests run via this script
# see the same system dependency paths as `make`. When invoked from
# test-integration-shard, CGO_CPPFLAGS/CGO_LDFLAGS may already be set by that
# script; the helper avoids double-adding duplicate words.
cgo_cppflags="${CGO_CPPFLAGS:-}"
cgo_ldflags="${CGO_LDFLAGS:-}"
configure_cgo_platform_paths

extra_env=()
while IFS='=' read -r name _; do
  case "$name" in
    ANTHROPIC_*|CLAUDE_CODE_*|GC_ACCEPTANCE_KEEP|GC_ACCEPTANCE_BD_BIN|GC_ACCEPTANCE_LEGACY_GC_BIN|GC_ACCEPTANCE_SPLIT_RC1_GC_BIN|GC_REQUIRE_ACCEPTANCE_SPLIT_RC1_GC|GC_TIERC_FORCE|GC_TUTORIAL_GOLDENS_USE_CLAUDE_FOR_CODEX)
      extra_env+=("${name}=${!name}")
      ;;
  esac
done < <(env)

run_in_test_env() {
  # The pane shell is pinned to /bin/sh, not forwarded from the caller: a test
  # tmux or herdr pane running zsh under a fresh HOME opens the new-user wizard,
  # which swallows the typed text (ga-yghhjf; mirrors Makefile TEST_ENV).
  local base_env=(
    PATH="${PATH}" \
    HOME="${HOME:-}" \
    USER="${USER:-}" \
    LOGNAME="${LOGNAME:-}" \
    SHELL=/bin/sh \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL="$gc_test_gitconfig" \
    LANG="${LANG:-C.UTF-8}" \
    TMPDIR="${TMPDIR:-/var/tmp}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    GOPATH="${gopath_val}" \
    GOCACHE="${gocache_val}" \
    GOMODCACHE="${gomodcache_val}" \
    GOTMPDIR="${gotmpdir_val}" \
    GOROOT="${GOROOT:-$goroot_val}" \
    GOENV="${GOENV-}" \
    GOFLAGS="${GOFLAGS-}" \
    GO111MODULE="${GO111MODULE-}" \
    GOEXPERIMENT="${GOEXPERIMENT-}" \
    GOPROXY="${GOPROXY-}" \
    GOPRIVATE="${GOPRIVATE-}" \
    GONOPROXY="${GONOPROXY-}" \
    GONOSUMDB="${GONOSUMDB-}" \
    GOSUMDB="${GOSUMDB-}" \
    GOINSECURE="${GOINSECURE-}" \
    GOVCS="${GOVCS-}" \
    GOWORK="${GOWORK-}" \
    GC_FAST_UNIT="${GC_FAST_UNIT:-0}" \
    CGO_CPPFLAGS="${cgo_cppflags}" \
    CGO_LDFLAGS="${cgo_ldflags}" \
    GC_TEST_SHARD_INDEX="${shard_index}" \
    GC_TEST_SHARD_TOTAL="${shard_total}"
  )
  if (( ${#extra_env[@]} > 0 )); then
    env -i "${base_env[@]}" "${extra_env[@]}" "$@"
  else
    env -i "${base_env[@]}" "$@"
  fi
}

run_go_test() {
  run_in_test_env go test "$@"
}

run_observable_go_test() {
  local timing_name="${GO_TEST_TIMING_NAME:-${test_pkg#./}-shard-${shard_index}-of-${shard_total}}"
  local observable_env=(
    OBSERVABLE_TIMING_FILE="${GO_TEST_TIMING_FILE}"
    OBSERVABLE_SHARD_ID="${timing_name}"
    OBSERVABLE_VARIANT="${GO_TEST_TIMING_VARIANT:-default}"
    OBSERVABLE_COMMIT_SHA="${GITHUB_SHA:-}"
    OBSERVABLE_WORKFLOW="${GITHUB_WORKFLOW:-}"
    OBSERVABLE_RUN_ID="${GITHUB_RUN_ID:-}"
    OBSERVABLE_RUN_ATTEMPT="${GITHUB_RUN_ATTEMPT:-}"
    OBSERVABLE_JOB="${GITHUB_JOB:-}"
    OBSERVABLE_RUNNER_LABEL="${GO_TEST_RUNNER_LABEL:-}"
    OBSERVABLE_RUNNER_NAME="${RUNNER_NAME:-}"
    OBSERVABLE_RUNNER_OS="${RUNNER_OS:-}"
    OBSERVABLE_RUNNER_ARCH="${RUNNER_ARCH:-}"
    OBSERVABLE_RUNNER_CPU_COUNT="${GO_TEST_RUNNER_CPU_COUNT:-}"
  )
  if [[ "${GC_TEST_NO_SLICE:-0}" == "1" ]]; then
    observable_env+=(GC_TEST_NO_SLICE=1)
  fi
  run_in_test_env "${observable_env[@]}" \
    "$repo_root/scripts/go-test-observable" "$timing_name" -- "$@"
}

go_test_args=(-timeout "$timeout")
if [[ -n "${GO_TEST_TAGS:-}" ]]; then
  go_test_args=(-tags "$GO_TEST_TAGS" "${go_test_args[@]}")
fi
if [[ -n "${GO_TEST_COUNT:-}" ]]; then
  go_test_args=(-count="$GO_TEST_COUNT" "${go_test_args[@]}")
fi
cover_profile="${GO_TEST_COVERPROFILE:-}"
if [[ -n "$cover_profile" ]]; then
  # Each product run names its own -coverprofile below: go test truncates that
  # file when it starts, so the chunks of one shard cannot share it.
  go_test_args+=(-coverpkg=./...)
fi

# Build once, run many (the fork's macOS cmd-gc process shards; ga-05vt3.12).
# Compiling cmd/gc's test package peaks at 10-12 GB, so on a 7 GB hosted
# runner every shard spent its whole job budget swapping through that one
# compile. Two opt-in modes split the compile from the shards:
#   - GO_TEST_SHARD_BUILD_ONLY=<path> compiles the package's test binary to
#     <path> (relative to the repository root) with exactly the environment,
#     tags and flags a shard's own `go test -c` uses, runs its -test.list to
#     prove it lists tests, and exits without selecting or running any;
#   - GO_TEST_SHARD_PREBUILT=<path> runs the shard from such a binary: no
#     `go test` at all. Discovery is the binary's -test.list, the selection is
#     the same modulo slice, and the product run is the binary itself, in the
#     package directory as go test would run it, with go test's flags spelled
#     as the binary's (-test.timeout, -test.count, -test.v). Name the binary
#     *.test, as go test does, so the progress SIGQUIT finds it.
# Coverage, timing capture and build tags belong to the compile, so a
# prebuilt shard refuses them rather than run without them.
prebuilt="${GO_TEST_SHARD_PREBUILT:-}"
build_only="${GO_TEST_SHARD_BUILD_ONLY:-}"
if [[ -n "$prebuilt" && -n "$build_only" ]]; then
  echo "GO_TEST_SHARD_PREBUILT and GO_TEST_SHARD_BUILD_ONLY are exclusive" >&2
  exit 1
fi
if [[ -n "$prebuilt" ]]; then
  if [[ ! -f "$prebuilt" || ! -x "$prebuilt" ]]; then
    echo "GO_TEST_SHARD_PREBUILT is not an executable file: ${prebuilt}" >&2
    exit 1
  fi
  for setting in GO_TEST_TAGS GO_TEST_COVERPROFILE GO_TEST_TIMING_FILE; do
    if [[ -n "${!setting:-}" ]]; then
      echo "GO_TEST_SHARD_PREBUILT runs a binary built elsewhere; ${setting} cannot apply to it" >&2
      exit 1
    fi
  done
  # The product runs from the package directory, so pin the path first.
  prebuilt="$(cd "$(dirname "$prebuilt")" && pwd)/$(basename "$prebuilt")"
fi
if [[ -n "$build_only" ]]; then
  for setting in GO_TEST_MANIFEST GO_TEST_COVERPROFILE GO_TEST_TIMING_FILE; do
    if [[ -n "${!setting:-}" ]]; then
      echo "GO_TEST_SHARD_BUILD_ONLY builds a binary and runs no tests; ${setting} cannot apply to it" >&2
      exit 1
    fi
  done
  mkdir -p "$(dirname "$build_only")"
  build_only="$(cd "$(dirname "$build_only")" && pwd)/$(basename "$build_only")"
fi

if [[ "$progress" == 1 ]]; then
  progress_interval="${GO_TEST_SHARD_PROGRESS_INTERVAL:-180}"
  if ! [[ "$progress_interval" =~ ^[0-9]+$ ]] || (( progress_interval < 1 )); then
    echo "GO_TEST_SHARD_PROGRESS_INTERVAL must be a positive number of seconds: ${progress_interval}" >&2
    exit 1
  fi
  progress_quit_after=""
  if [[ -n "${GO_TEST_SHARD_PROGRESS_QUIT_AFTER:-}" ]] &&
    ! progress_quit_after="$(gc_harness_duration_seconds "$GO_TEST_SHARD_PROGRESS_QUIT_AFTER")"; then
    echo "GO_TEST_SHARD_PROGRESS_QUIT_AFTER must be an <n>[s|m|h] duration: ${GO_TEST_SHARD_PROGRESS_QUIT_AFTER}" >&2
    exit 1
  fi
  progress_dir="$(mktemp -d "${TMPDIR:-/var/tmp}/gc-shard-progress.XXXXXX")"
  gc_shard_progress "progress on for ${test_pkg} shard ${shard_index} of ${shard_total}: heartbeat every ${progress_interval}s, SIGQUIT to test binaries after ${GO_TEST_SHARD_PROGRESS_QUIT_AFTER:-never}"
  if [[ -n "$prebuilt" ]]; then
    gc_shard_progress "prebuilt: ${prebuilt}"
  fi
  gc_shard_progress_heartbeat "$progress_interval" "$progress_quit_after" &
  progress_pid=$!
  go_test_args=(-v "${go_test_args[@]}")
fi

# pkg_dir is where go test runs a package's test binary; a binary this script
# runs itself runs there too.
pkg_dir=""
gc_shard_resolve_pkg_dir() {
  [[ -z "$pkg_dir" ]] || return 0
  if ! pkg_dir="$(run_in_test_env go list -f '{{.Dir}}' "$test_pkg")"; then
    echo "go list could not resolve the directory of ${test_pkg}" >&2
    exit 1
  fi
}

# The flags go test hands a test binary for a product run, in its own
# spelling, for a binary this script runs itself.
binary_args=(-test.paniconexit0 -test.timeout="$timeout")
if [[ -n "${GO_TEST_COUNT:-}" ]]; then
  binary_args+=(-test.count="$GO_TEST_COUNT")
fi
if [[ "$progress" == 1 ]]; then
  binary_args+=(-test.v=true)
fi

run_prebuilt_test() {
  (cd "$pkg_dir" && run_in_test_env "$prebuilt" "$@")
}

tests=()
if [[ ${GO_TEST_MANIFEST+x} == x ]]; then
  if [[ ! -f "$GO_TEST_MANIFEST" || ! -r "$GO_TEST_MANIFEST" ]]; then
    echo "go test manifest is not readable: ${GO_TEST_MANIFEST}" >&2
    exit 1
  fi
  if ! LC_ALL=C tr -d '\000' < "$GO_TEST_MANIFEST" | cmp -s "$GO_TEST_MANIFEST" -; then
    echo "go test manifest contains NUL bytes or could not be validated: ${GO_TEST_MANIFEST}" >&2
    exit 1
  fi

  line_number=0
  manifest_test_count=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    if [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]]; then
      continue
    fi
    if ! [[ "$line" =~ ^Test$ || "$line" =~ ^Test[A-Z0-9_][A-Za-z0-9_]*$ ]]; then
      echo "invalid go test manifest entry in ${GO_TEST_MANIFEST} at line ${line_number}: ${line}" >&2
      exit 1
    fi
    if (( manifest_test_count > 0 )); then
      for existing in "${tests[@]}"; do
        if [[ "$existing" == "$line" ]]; then
          echo "duplicate go test manifest entry: ${line}" >&2
          exit 1
        fi
      done
    fi
    tests+=("$line")
    manifest_test_count=$((manifest_test_count + 1))
  done < "$GO_TEST_MANIFEST"

  if (( manifest_test_count == 0 )); then
    echo "go test manifest contains no tests: ${GO_TEST_MANIFEST}" >&2
    exit 1
  fi
else
  # Capture the enumeration separately so a build/compile failure here surfaces
  # its output. `go test -list` builds the test binary; if that fails, the bare
  # assignment's non-zero status is swallowed by `set -e` (the script dies before
  # the "no tests discovered" branch below), producing an undebuggable empty
  # shard failure. Check the status explicitly and print what go printed.
  list_status=0
  if [[ -n "$prebuilt" || -n "$build_only" || "$progress" == 1 ]]; then
    # Compile and link the binary (unless it is prebuilt), then run it under
    # -test.list in the package directory, as go test would, so each phase
    # gets its own time in the log.
    if [[ -n "$prebuilt" ]]; then
      test_bin="$prebuilt"
    else
      build_args=()
      if [[ -n "${GO_TEST_TAGS:-}" ]]; then
        build_args=(-tags "$GO_TEST_TAGS")
      fi
      test_bin="${build_only:-${progress_dir}/$(basename "$test_pkg").test}"
      gc_shard_progress "compile: go test -c ${test_pkg}"
      if ! list_output="$(run_go_test ${build_args[@]+"${build_args[@]}"} -c -o "$test_bin" "$test_pkg" 2>&1)"; then
        echo "go test -c failed for ${test_pkg} (build/compile error); output:" >&2
        printf '%s\n' "$list_output" >&2
        exit 1
      fi
      gc_shard_progress "compile done"
    fi
    gc_shard_resolve_pkg_dir
    gc_shard_progress "discovery: $(basename "$test_bin") -test.list (runs TestMain)"
    list_output="$(cd "$pkg_dir" && run_in_test_env "$test_bin" -test.timeout="$timeout" -test.list '^Test' 2>&1)" || list_status=$?
    gc_shard_progress "discovery done (status ${list_status})"
  else
    list_output="$(run_go_test "${go_test_args[@]}" "$test_pkg" -list '^Test' 2>&1)" || list_status=$?
  fi
  if (( list_status != 0 )); then
    echo "go test -list failed for ${test_pkg} (build/compile error); output:" >&2
    printf '%s\n' "$list_output" >&2
    exit 1
  fi
  while IFS= read -r line; do
    [[ "$line" == Test* ]] || continue
    tests+=("$line")
  done <<< "$list_output"

  if [[ ${#tests[@]} -eq 0 ]]; then
    echo "no tests discovered for ${test_pkg}; go test -list output:" >&2
    printf '%s\n' "$list_output" >&2
    exit 1
  fi
fi

if [[ -n "$build_only" ]]; then
  echo "built ${test_pkg} test binary ${build_only} (${#tests[@]} tests)"
  exit 0
fi
if [[ -n "$prebuilt" ]]; then
  gc_shard_resolve_pkg_dir
fi

selected=()
for i in "${!tests[@]}"; do
  if (( i % shard_total == shard_index - 1 )); then
    selected+=("${tests[$i]}")
  fi
done

if [[ ${#selected[@]} -eq 0 ]]; then
  echo "no tests selected for ${test_pkg} shard ${shard_index} of ${shard_total}" >&2
  exit 1
fi

join_regex() {
  local IFS='|'
  printf '%s' "$*"
}

# The selected names travel to go test, and from go test to the test binary,
# as a single -run argument. Linux caps one argv string at MAX_ARG_STRLEN
# (128 KiB), and a cmd/gc shard's alternation alone exceeds it, failing the
# exec with "Argument list too long" before any test runs (ga-f4ovjm.47). The
# names are therefore packed in order into chunks whose anchored regex stays
# within a byte budget, and each chunk is one go test invocation. A shard that
# fits in one chunk runs exactly as before. The default budget, 120 KiB, stays
# 8 KiB under the cap: go test hands the regex on as "-test.run=<regex>", and
# ${#name} counts characters, which a non-ASCII name exceeds in bytes.
run_regex_budget="${GO_TEST_RUN_REGEX_MAX_BYTES:-122880}"
if ! [[ "$run_regex_budget" =~ ^[0-9]+$ ]] || (( run_regex_budget < 1 )); then
  echo "GO_TEST_RUN_REGEX_MAX_BYTES must be a positive integer: ${run_regex_budget}" >&2
  exit 1
fi
regex_chunks=()
chunk_names=()
chunk_bytes=0
for name in "${selected[@]}"; do
  # "^(" + ")$" is 4 bytes; each further name adds itself plus "|".
  if (( ${#chunk_names[@]} > 0 && chunk_bytes + 1 + ${#name} > run_regex_budget )); then
    regex_chunks+=("^($(join_regex "${chunk_names[@]}"))$")
    chunk_names=()
  fi
  if (( ${#chunk_names[@]} == 0 )); then
    chunk_bytes=$(( 4 + ${#name} ))
  else
    chunk_bytes=$(( chunk_bytes + 1 + ${#name} ))
  fi
  chunk_names+=("$name")
done
regex_chunks+=("^($(join_regex "${chunk_names[@]}"))$")
chunk_total=${#regex_chunks[@]}

echo "Running ${test_pkg} shard ${shard_index} of ${shard_total} (${#selected[@]} tests)"
printf '  %s\n' "${selected[@]}"
# The product run's own link and TestMain setup end at its first `=== RUN`.
if [[ -n "$prebuilt" ]]; then
  gc_shard_progress "product run: $(basename "$prebuilt") -test.v (TestMain setup ends at the first === RUN)"
else
  gc_shard_progress "product run: go test -v (link and TestMain setup end at the first === RUN)"
fi
# External watchdog budget. `-timeout` bounds only the test binary, and only
# while go's own timeout goroutine can still be scheduled — the failure this
# guards against is precisely one that defeats it. The budget therefore adds a
# grace on top of the go timeout, wide enough to cover the build that precedes
# the run under a full parallel fan-out. GO_TEST_WATCHDOG_GRACE=off disables
# the watchdog; an unparseable timeout leaves it disarmed rather than firing at
# a guessed budget.
watchdog_deadline=""
watchdog_quit_grace=30
watchdog_grace="${GO_TEST_WATCHDOG_GRACE:-10m}"
if [[ "$watchdog_grace" != "off" ]]; then
  if timeout_seconds="$(gc_harness_duration_seconds "$timeout")" &&
    grace_seconds="$(gc_harness_duration_seconds "$watchdog_grace")"; then
    watchdog_deadline=$(( timeout_seconds + grace_seconds ))
  else
    echo "harness watchdog disarmed: GO_TEST_TIMEOUT=${timeout} GO_TEST_WATCHDOG_GRACE=${watchdog_grace} is not a <n>[s|m|h] duration" >&2
  fi
fi

shard_label="${test_pkg#./} shard ${shard_index} of ${shard_total}"
timing_file="${GO_TEST_TIMING_FILE:-}"
chunk_timing_files=()
chunk_cover_profiles=()

# A chunked shard publishes the requested coverage profile and timing artifact
# only by merging its chunks' files after the last chunk, so stale ones from an
# earlier run are removed first, as go test and go-test-observable do before a
# single run: a profile that cannot be removed stops the shard, as go test stops
# when it cannot create one, while timing capture is only disabled.
merge_chunk_timing=0
if (( chunk_total > 1 )); then
  if [[ -n "$cover_profile" ]]; then
    rm -f "$cover_profile"
  fi
  if [[ -n "$timing_file" ]]; then
    if rm -f "$timing_file"; then
      merge_chunk_timing=1
    else
      echo "observable go test: warning: cannot remove stale timing artifact ${timing_file}; capture disabled" >&2
      GO_TEST_TIMING_FILE=""
    fi
  fi
fi

# Each chunk is its own supervised run with the full watchdog budget, so the
# per-run guarantee is unchanged. Every chunk runs even after one fails, as a
# single invocation would have run every test; the shard exits with the first
# failing chunk's status.
shard_status=0
for chunk_i in "${!regex_chunks[@]}"; do
  chunk_label="$shard_label"
  chunk_args=("${go_test_args[@]}")
  chunk_cover_profile="$cover_profile"
  if (( chunk_total > 1 )); then
    chunk_label+=" chunk $(( chunk_i + 1 )) of ${chunk_total}"
    echo "Running ${chunk_label}"
    if [[ -n "$cover_profile" ]]; then
      chunk_cover_profile="${cover_profile}.chunk-$(( chunk_i + 1 ))"
      chunk_cover_profiles+=("$chunk_cover_profile")
    fi
    if (( merge_chunk_timing == 1 )); then
      GO_TEST_TIMING_FILE="${timing_file}.chunk-$(( chunk_i + 1 ))"
      chunk_timing_files+=("$GO_TEST_TIMING_FILE")
    fi
  fi
  if [[ -n "$chunk_cover_profile" ]]; then
    chunk_args+=(-coverprofile "$chunk_cover_profile")
  fi
  chunk_status=0
  if [[ -n "$prebuilt" ]]; then
    gc_harness_run_supervised "$chunk_label" "$watchdog_deadline" "$watchdog_quit_grace" -- \
      run_prebuilt_test "${binary_args[@]}" -test.run="${regex_chunks[$chunk_i]}" || chunk_status=$?
  elif [[ -n "$timing_file" ]]; then
    gc_harness_run_supervised "$chunk_label" "$watchdog_deadline" "$watchdog_quit_grace" -- \
      run_observable_go_test "${chunk_args[@]}" "$test_pkg" -run "${regex_chunks[$chunk_i]}" || chunk_status=$?
  else
    gc_harness_run_supervised "$chunk_label" "$watchdog_deadline" "$watchdog_quit_grace" -- \
      run_go_test "${chunk_args[@]}" "$test_pkg" -run "${regex_chunks[$chunk_i]}" || chunk_status=$?
  fi
  gc_shard_progress "${chunk_label}: product run done (status ${chunk_status})"
  if (( chunk_status != 0 )); then
    echo "${chunk_label}: FAIL status=${chunk_status}" >&2
    if (( shard_status == 0 )); then
      shard_status=$chunk_status
    fi
  fi
done

# Chunked coverage is merged back into the one profile the caller asked for.
# Coverage is what a cover run exists to produce, so unlike timing, chunk
# profiles that cannot be merged fail the shard rather than leave it partial.
if (( ${#chunk_cover_profiles[@]} > 0 )); then
  if ! "$repo_root/scripts/merge-coverprofiles" "$cover_profile" "${chunk_cover_profiles[@]}"; then
    rm -f "$cover_profile"
    echo "${shard_label}: FAIL could not merge ${chunk_total} chunk coverage profiles into ${cover_profile}" >&2
    if (( shard_status == 0 )); then
      shard_status=1
    fi
  fi
  rm -f "${chunk_cover_profiles[@]}"
fi

# Chunked timing is merged back into the one artifact the caller asked for, so
# a chunked shard publishes the same file and shard identity as an unchunked
# one. Like the per-run capture, this is advisory: it never changes the status.
if (( ${#chunk_timing_files[@]} > 0 )); then
  merged_timing=0
  if command -v jq >/dev/null 2>&1 &&
    timing_tmp="$(mktemp "${timing_file}.tmp.XXXXXX" 2>/dev/null)"; then
    if jq -s -e '
        .[0] + {units: ([.[].units[]] | sort_by([.unit_id, .kind, .outcome, .duration_seconds]))}
      ' "${chunk_timing_files[@]}" >"$timing_tmp" 2>/dev/null &&
      mv -f "$timing_tmp" "$timing_file"; then
      merged_timing=1
      echo "observable go test: timing=${timing_file} (merged ${chunk_total} chunks)" >&2
    else
      rm -f "$timing_tmp"
    fi
  fi
  if (( merged_timing == 0 )); then
    echo "observable go test: warning: could not merge ${chunk_total} chunk timing artifacts into ${timing_file}" >&2
  fi
  rm -f "${chunk_timing_files[@]}"
fi

exit "$shard_status"
