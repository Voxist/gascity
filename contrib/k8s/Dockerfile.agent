# Gas City agent container image — binary layer.
#
# Built on top of gc-agent-base (Dockerfile.base) which has all system
# dependencies. This layer only copies project binaries, so rebuilds
# after code changes take ~5s instead of ~2.5 min.
#
# Build:
#   make docker-agent
#   # or: docker build -f contrib/k8s/Dockerfile.agent -t gc-agent:latest .
#
# Full rebuild (base + agent):
#   make docker-base docker-agent
#
# The gc binary should be built first and placed in the build context root:
#   CGO_ENABLED=0 go build -o gc ./cmd/gc

# Local build-layer image produced by Dockerfile.base, not a registry pull.
ARG BASE_IMAGE=gc-agent-base:latest

FROM golang:1.26.8-bookworm@sha256:9fdc884aacc3bec89b20ffc69f4bb369c78210e3e4f600387b5128b12c199f81 AS bd-builder

# FORK-FIRST BRIDGE (supersedes the ADR-0026 C5 upstream bridge; ga-zzcjs) —
# keep in lockstep with deps.env. BD_VERSION is the version string the pinned
# source declares; BD_SOURCE_REF is the commit built from. No published
# upstream release carries schema 0066 yet, so this image builds bd from the
# Voxist/beads fork tip, whose newest upstream ancestor (BD_LIB_REF
# d530cddfa64b) is the commit gc's go.mod links — same schema, no skew.
# Retire the bridge once a release >= 0066 exists on a module-resolvable repo:
# set BD_VERSION to that tag and drop BD_SOURCE_REF/BD_SOURCE_SHA256.
ARG BD_VERSION=v1.2.2
ARG BD_REPO=Voxist/beads
ARG BD_SOURCE_REF=3e03250ee1675ebcd63ca3f5d1660560947eab7c
ARG BD_SOURCE_SHA256=587ad18b765d90e75b64ca4bb57c12520befd8bece96545d48e98add26bc8f0f
ARG BD_BUILD=3e03250ee
ARG BD_BRANCH=HEAD
# 1.83.1, not 1.83.0: CVE-2026-84304 (HIGH) is in 1.83.0 and fixed in 1.83.1.
ARG GRPC_VERSION=1.83.1
# x/text 0.41.0, not 0.40.0: the x/crypto floor below drags x/text to 0.41.0,
# and pinning BELOW what the module graph then selects is a silent downgrade
# (ga-0emb8). Every override here must be >= what the pinned source resolves.
ARG XTEXT_VERSION=0.41.0
# The pinned beads source declares x/crypto 0.54.0 (CVE-2026-56854, CRITICAL,
# fixed 0.55.0) and x/mod 0.37.0 (CVE-2026-56864, HIGH, fixed 0.40.0). The
# image scan gates HIGH+CRITICAL with --exit-code 1, so both floors are needed
# for a green scan; verified against the exact pinned source: all upgrades, no
# downgrades, bd builds.
ARG XCRYPTO_VERSION=0.55.0
ARG XMOD_VERSION=0.40.0

# bd resolves grpc and x/text through the beads module graph, not this repo's,
# so gc's own go.mod bumps do not reach this image and the overrides below are
# required. Both must be >= what the pinned source already declares — pinning
# BELOW it silently downgrades the shipped binary (and drags x/net and x/crypto
# back with it), which neither post-build assertion would catch. At
# BD_SOURCE_REF 3e03250ee the source resolves grpc 1.83.0 and x/text 0.40.0;
# the floors below sit above both (grpc 1.83.1 for CVE-2026-84304, and x/text
# 0.41.0 because the x/crypto floor drags it there).
#
# Rebuild the pinned fork source with its production CGO/pure-Go-regex
# configuration and release identity, changing only the patched dependency
# versions. (Pinned fork commit, not a published release.)
RUN mkdir -p /src/bd /out \
    && curl -fsSL --retry 3 \
       "https://github.com/${BD_REPO}/archive/${BD_SOURCE_REF}.tar.gz" \
       -o /tmp/bd-source.tar.gz \
    && echo "${BD_SOURCE_SHA256}  /tmp/bd-source.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/bd-source.tar.gz --strip-components=1 -C /src/bd \
    && rm -f /tmp/bd-source.tar.gz

WORKDIR /src/bd
RUN bd_version="${BD_VERSION#v}" \
    && grep -Fq "Version = \"${bd_version}\"" cmd/bd/version.go \
    && go get "google.golang.org/grpc@v${GRPC_VERSION}" \
    && go get "golang.org/x/text@v${XTEXT_VERSION}" \
    && go get "golang.org/x/crypto@v${XCRYPTO_VERSION}" \
    && go get "golang.org/x/mod@v${XMOD_VERSION}" \
    && CGO_ENABLED=1 go build \
       -tags="gms_pure_go" \
       -trimpath \
       -ldflags="-s -w -X main.Version=${bd_version} -X main.Build=${BD_BUILD} -X main.Commit=${BD_SOURCE_REF} -X main.Branch=${BD_BRANCH}" \
       -o /out/bd \
       ./cmd/bd \
    && /out/bd --version | grep -Fq "bd version ${bd_version} (${BD_BUILD})" \
    && go version -m /out/bd | tr '\t' ' ' | grep -Fq "dep google.golang.org/grpc v${GRPC_VERSION} " \
    && go version -m /out/bd | tr '\t' ' ' | grep -Fq "dep golang.org/x/text v${XTEXT_VERSION} " \
    && go version -m /out/bd | tr '\t' ' ' | grep -Fq "dep golang.org/x/crypto v${XCRYPTO_VERSION} " \
    && go version -m /out/bd | tr '\t' ' ' | grep -Fq "dep golang.org/x/mod v${XMOD_VERSION} "

FROM ${BASE_IMAGE}

# Build-time copies and ownership fixes require root; the final image drops
# back to gcagent below.
USER root

# bd (beads) CLI, rebuilt above from checksum-pinned release source.
COPY --from=bd-builder /out/bd /usr/local/bin/bd
RUN BD_DISABLE_METRICS=1 BD_DISABLE_EVENT_FLUSH=1 bd --version

# br (beads_rust) CLI — copied from build context.
# Build with: cp $(which br) . && docker build ...
COPY br /usr/local/bin/br

# gc binary — copied from build context.
COPY gc /usr/local/bin/gc
RUN gc version

# gc-beads-br script for the exec:beads protocol.
COPY contrib/beads-scripts/gc-beads-br /usr/local/bin/gc-beads-br

# gc-mail-mcp-agent-mail script for the exec:mail protocol.
COPY contrib/mail-scripts/gc-mail-mcp-agent-mail /usr/local/bin/gc-mail-mcp-agent-mail

# Claude credentials are injected at runtime via K8s Secret volume mount,
# not baked into the image. See contrib/k8s/README-credentials.md.
# The CLAUDE_CONFIG_DIR env var (set by gc-session-k8s) points to the mount.

WORKDIR /workspace
RUN chown gcagent:gcagent /workspace

# Default user. When LINUX_USERNAME is set, the pod spec overrides to root
# (UID 0) via securityContext so the entrypoint can create the dynamic user
# before dropping privileges.
USER gcagent

CMD ["/bin/bash"]
